_npk        STRUCT  0
@@lst       QSET    0
@@ins       QSET    0
@@vol       QSET    0
@@len       QSET    0
@@str       QSET    0

@@rows      QSET    0
@@count     QSET    0
@@open      QSET    0
            ENDS

;; ======================================================================== ;;
;;  DRUM(t_per, n_per, tone, noise, vol)                                    ;;
;;  Defines a drum sample record.                                           ;;
;;                                                                          ;;
;;  ARGUMENTS                                                               ;;
;;      t_per       PSG tone period.                                        ;;
;;      n_per       PSG noise period.                                       ;;
;;      tone        Enable tone flag (1 = on; 0 = off).                     ;;
;;      noise       Enable noise flag (1 = on; 0 = off).                    ;;
;;      vol         Volume level (0..15).                                   ;;
;; ======================================================================== ;;
MACRO DRUM(t_per, n_per, tone, noise, vol)
            DECLE   %t_per%, %n_per%, (($39 - %tone%) - (%noise% SHL 3)), %vol%
ENDM

;; ======================================================================== ;;
;;  NOTES(n0, n1, n2, n3)                                                   ;;
;;  Defines four note events at once.  This macro calls NOTES() four times. ;;
;;                                                                          ;;
;;  ARGUMENTS                                                               ;;
;;      n0          Row event string #0.                                    ;;
;;      n1          Row event string #1.                                    ;;
;;      n2          Row event string #2.                                    ;;
;;      n3          Row event string #3.                                    ;;
;; ======================================================================== ;;
MACRO NOTES(n0, n1, n2, n3)
;
    LISTING "code"

        NOTE(%n0%)
        NOTE(%n1%)
        NOTE(%n2%)
        NOTE(%n3%)

    LISTING "prev"
ENDM

;; ======================================================================== ;;
;;  NOTE(n)                                                                 ;;
;;  Defines a note event record.  The format for the event string is:       ;;
;;      "NnO IVL"                                                           ;;
;;  Where each token represents:                                            ;;
;;    N = Note (C, D, E, F, G, A, B)                                        ;;
;;    n = '-' or '#'                                                        ;;
;;    O = Octave (1 to 7)                                                   ;;
;;    I = new Instrument (1 to F, or 0 for unchanged)                       ;;
;;    V = Volume (0 to F)                                                   ;;
;;    L = Length (0 to F)                                                   ;;
;;                                                                          ;;
;;    The following strings can be used instead of the "NnO" parameters:    ;;
;;      "DRM" --> Drum event: invokes a drum.                               ;;
;;      "NUL" --> Null event: no note change.                               ;;
;;                                                                          ;;
;;    Examples:                                                             ;;
;;      "C-3 1F1", "D#4 0F1", "DRM 1F1", "NUL 0F1"                          ;;
;;                                                                          ;;
;;  ARGUMENTS                                                               ;;
;;      n           Row event string in the format "NnO IVL".               ;;
;; ======================================================================== ;;
MACRO NOTE(n)
;
    LISTING "code"

        IF (STRLEN(%n%) > 0)

_Chr2Dec(_i, ASC(%n%, 4))           ; _i = Instrument
_Hex2Dec(_v, ASC(%n%, 5))           ; _v = Volume
_Hex2Dec(_l, ASC(%n%, 6))           ; _l = Length

            _RenderEvent(%n%, _i, _v, _l)

        ENDI

    LISTING "prev"
ENDM

;; ======================================================================== ;;
;;  NPK.Begin(rows)                                                         ;;
;;  Opens a new NPK pattern.  NPK patterns are defined as a series of       ;;
;;  discrete rows, similar to the NOTE() macro, but automatically packed    ;;
;;  into event records.                                                     ;;
;;                                                                          ;;
;;  If a number of rows is given, it will also validate that the total      ;;
;;  number of rows collected for all events is exactly the expected value.  ;;
;;                                                                          ;;
;;  NPK patterns are very useful for defining drum tracks, which are easier ;;
;;  to visualize as individual events placed on a linear scale of discrete  ;;
;;  rows.                                                                   ;;
;;                                                                          ;;
;;  For example, the following NPK pattern represents two drum hits lasting ;;
;;  four rows each, for a total of 8 rows for the entire pattern:           ;;
;;                                                                          ;;
;;      NPK.Begin(8)                                                        ;;
;;        NPK.Note("DRM 1F0")                                               ;;
;;        NPK.Note("NUL 0F0")                                               ;;
;;        NPK.Note("NUL 0F0")                                               ;;
;;                                                                          ;;
;;        NPK.Note("DRM 2F0")                                               ;;
;;        NPK.Note("NUL 0F0")                                               ;;
;;        NPK.Note("NUL 0F0")                                               ;;
;;      NPK.End                                                             ;;
;;                                                                          ;;
;;  It will be packed as if it were enter in this way:                      ;;
;;                                                                          ;;
;;      NOTE("DRM 1F3")                                                     ;;
;;      NOTE("DRM 2F3")                                                     ;;
;;                                                                          ;;
;;  Thus, listing all the individual rows discretely makes it is easier to  ;;
;;  visualize the full scope of the pattern, allowing you to add syncopated ;;
;;  accents, etc. while maintaining the beat.                               ;;
;;                                                                          ;;
;;  NOTE:                                                                   ;;
;;      NPK patterns must be opened with the NPK.Begin() directive, and     ;;
;;      closed with the NPK.End directive.                                  ;;
;;                                                                          ;;
;;  ARGUMENTS                                                               ;;
;;      rows        Number of rows expected in pattern, or zero to suppress ;;
;;                  length validation.                                      ;;
;; ======================================================================== ;;
MACRO   NPK.Begin(rows)
;
    LISTING "off"

        IF (_npk.open <> 0)
            ERR "NPK pattern block already open!  Open NPK patterns must first be closed with 'NPK.End'."
        ELSE
            _reset_event

_npk.open   QSET    1
_npk.count  QSET    0
_npk.rows   QSET    %rows%
        ENDI

    LISTING "prev"
ENDM

;; ======================================================================== ;;
;;  NPK.End                                                                 ;;
;;  Closes an open NPK pattern.  See NPK.Begin() for more information on    ;;
;;  NPK patterns.                                                           ;;
;;                                                                          ;;
;;  NOTE:                                                                   ;;
;;      NPK patterns must be opened with the NPK.Begin() directive, and     ;;
;;      closed with the NPK.End directive.                                  ;;
;;                                                                          ;;
;;  ARGUMENTS                                                               ;;
;;      None.                                                               ;;
;; ======================================================================== ;;
MACRO   NPK.End
;
    LISTING "code"

        IF (_npk.open = 0)
            ERR "NPK pattern block not open!  NPK patterns must first be opened with 'NPK.Begin'."
        ELSE
          IF (_npk.str <> 0)
            _RenderEvent(_stringify(_npk.str), _npk.ins, _npk.vol, (_npk.len - 1))
          ENDI

          ; If row count validation is enabled, enforce it.
          IF (_npk.rows > 0)
            IF (_npk.count > _npk.rows)
                ERR $("Too many rows in pattern. ", $#(_npk.rows), " expected, ", $#(_npk.count), " found.")
            ENDI

            IF (_npk.count < _npk.rows)
                ERR $("Too few rows in pattern. ",  $#(_npk.rows), " expected, ", $#(_npk.count), " found.")
            ENDI
          ENDI

            _reset_event

_npk.count  QSET    0
_npk.rows   QSET    0
_npk.open   QSET    0
        ENDI

    LISTING "prev"
ENDM

;; ======================================================================== ;;
;;  NPK.Note(n)                                                             ;;
;;  Defines a discrete event row as part of an NPK pattern. See NPK.Begin() ;;
;;  for more information on NPK patterns.                                   ;;
;;                                                                          ;;
;;  The format of the argument is the same as that of the NOTE() macro:     ;;
;;      "NnO IVL"                                                           ;;
;;  Where each token represents:                                            ;;
;;    N = Note (C, D, E, F, G, A, B)                                        ;;
;;    n = '-' or '#'                                                        ;;
;;    O = Octave (1 to 7)                                                   ;;
;;    I = new Instrument (1 to F, or 0 for unchanged)                       ;;
;;    V = Volume (0 to F)                                                   ;;
;;    L = Length (0 to F)                                                   ;;
;;                                                                          ;;
;;    The following strings can be used instead of the "NnO" parameters:    ;;
;;      "DRM" --> Drum event: invokes a drum.                               ;;
;;      "NUL" --> Null event: no note change.                               ;;
;;                                                                          ;;
;;    Examples:                                                             ;;
;;      "C-3 1F1", "D#4 0F1", "DRM 1F1", "NUL 0F1"                          ;;
;;                                                                          ;;
;;  ARGUMENTS                                                               ;;
;;      n           Row event string in the format "NnO IVL".               ;;
;; ======================================================================== ;;
MACRO   NPK.Note(n)
;
    LISTING "code"

      IF (_npk.open = 0)
        ERR "NPK pattern block not open!  NPK patterns must first be opened with 'NPK.Begin'."
      ELSE

        IF (STRLEN(%n%) > 0)

          ; Decode tokens
_Chr2Dec(_i, ASC(%n%, 4))                       ; _i = Instrument
_Hex2Dec(_v, ASC(%n%, 5))                       ; _v = Volume
_Hex2Dec(_l, ASC(%n%, 6))                       ; _l = Length

          ; Verify that DRUM events have a valid
          ; instrument number.
          IF _is_DRM(%n%)
            IF ((_i = 0) OR (_i > 127))
                ERR $("Invalid drum instrument '", $#(_i), "'.  Drum instruments must be a value between 1 and 127.")
            ENDI
          ENDI

_new        QSET    0
_l          QSET    (_l + 1)                    ; Convert length into one-based
_npk.count  QSET    (_npk.count + _l)           ; Count all rows processed

          ; Note that for the purposes of pattern
          ; composition, the very first row is
          ; considered a new event, even if it is
          ; a Null Event (NUL).
          IF (_is_new_event(%n%) OR (_npk.str = 0))
_new        QSET    1
          ELSE

            ; If the instrument or volume changed,
            ; register a new event.
            IF _is_change_event(_i, _v)
_new        QSET    1

            ; Otherwise, extend the previous one.
            ELSE
_newlen     QSET    (_npk.len + _l)

                ; Check if the length overflows, and
                ; if so, split it into a new event.
                IF (_newlen > 16)
_npk.len    QSET    16                          ; Cap the length of an event to 15 rows
_l          QSET    (_newlen - _npk.len)
_new        QSET    1
                ENDI
            ENDI

          ENDI

          ; Keep track of new event ...
          IF (_new)

            ; Post previous event if we have one
            IF (_npk.str <> 0)

              ; For non-drum events, only emit the
              ; instrument if we have a different
              ; one than the last one used in the
              ; pattern.
              IF (_npk.ins <> _npk.lst) OR (_is_DRM(_stringify(_npk.str)))
__inst      QSET    _npk.ins
              ELSE
__inst      QSET    0
              ENDI

              _RenderEvent(_stringify(_npk.str), __inst, _npk.vol, (_npk.len - 1))

            ; Keep track of the last instrument
            ; used in this pattern.
_npk.lst    QSET    _npk.ins
            ENDI

_npk.ins    QSET    _i
_npk.vol    QSET    _v
_npk.len    QSET    0
_npk.str    QSET    0                           ; \_ Reset array symbol ...
_npk.str    QSET    %n%                         ; /

          ENDI

            ; Keep track of the new length
_npk.len    QSET    (_npk.len + _l)

        ENDI

      ENDI

    LISTING "prev"
ENDM

;; ======================================================================== ;;
;;  _RenderEvent(n, i, v, l)                                                ;;
;;  Private macro used by NPK.Note() to render an event into the output     ;;
;;  stream.                                                                 ;;
;;                                                                          ;;
;;  ARGUMENTS                                                               ;;
;;      n           The note event string, as received by NPK.Note().       ;;
;;      i           The instrument value.                                   ;;
;;      v           The volume level.                                       ;;
;;      l           The length, in rows (zero-based).                       ;;
;; ======================================================================== ;;
MACRO   _RenderEvent(n, i, v, l)
;
        IF _is_DRM(%n%)
            _InsertDrum(%n%, %i%, %v%, %l%)
        ELSE
            IF _is_NUL(%n%)
                _InsertNull(%n%, %i%, %v%, %l%)
            ELSE
                _InsertNote(%n%, %i%, %v%, %l%)
            ENDI
        ENDI
ENDM

;; ======================================================================== ;;
;;  _InsertDrum(n, i, v, l)                                                 ;;
;;  Private macro used by NPK.Note() to render a drum event to the output   ;;
;;  stream.                                                                 ;;
;;                                                                          ;;
;;  ARGUMENTS                                                               ;;
;;      n           Ignored.  (Kept for interface consistency.)             ;;
;;      i           The drum instrument value.                              ;;
;;      v           The volume level.                                       ;;
;;      l           The length, in rows (zero-based).                       ;;
;; ======================================================================== ;;
MACRO   _InsertDrum(n, i, v, l)
            DECLE   ((84 + %i%) SHL 8) + (%l% SHL 4) + (15 - %v%)
ENDM

;; ======================================================================== ;;
;;  _InsertNull(n, i, v, l)                                                 ;;
;;  Private macro used by NPK.Note() to render a drum event to the output   ;;
;;  stream.                                                                 ;;
;;                                                                          ;;
;;  ARGUMENTS                                                               ;;
;;      n           Ignored.  (Kept for interface consistency.)             ;;
;;      i           The drum instrument value.                              ;;
;;      v           The volume level.                                       ;;
;;      l           The length, in rows (zero-based).                       ;;
;; ======================================================================== ;;
MACRO   _InsertNull(n, i, v, l)
;
        IF (%i% <> 0)
            DECLE   $8000 + (%l% * $10) + (15 - %v%)
            DECLE   ((%i% - 1) * 3)
        ELSE
            DECLE   ((%l% * $10) + (15 - %v%))
        ENDI
ENDM

;; ======================================================================== ;;
;;  _InsertNote(n, i, v, l)                                                 ;;
;;  Private macro used by NPK.Note() to render a drum event to the output   ;;
;;  stream.                                                                 ;;
;;                                                                          ;;
;;  ARGUMENTS                                                               ;;
;;      n           The note event string, as received by NPK.Note().       ;;
;;      i           The note instrument value.                              ;;
;;      v           The volume level.                                       ;;
;;      l           The length, in rows (zero-based).                       ;;
;; ======================================================================== ;;
MACRO _InsertNote(n, i, v, l)
        ; Note
        ;     - Character in ASCII Code
        ;     - Range: 0..7 :: ASC('A')..ASC('G')
        ; ----------------------------------------
_n0         QSET   ASC(%n%, 0)

        IF (_n0 < 65) OR (_n0 > 71)
            ERR "Invalid note"
        ENDI

        ; Conversion letter -> value
        ;
        ;       ABCDEFG -> JLACEFH
        ;
        ;   Translates a note letter to a semi-tone
        ;   in the range of 0x01..0x0C (12 per
        ;   octave) corresponding to the notes
        ;   starting at "C".
        ;
        ;     A (65) = 0  ->  J (74) = (9 + 1) = A
        ;     B (66) = 1  ->  L (76) = (B + 1) = C
        ;     C (67) = 2  ->  A (65) = (0 + 1) = 1
        ;     D (68) = 3  ->  C (67) = (2 + 1) = 3
        ;     E (69) = 4  ->  E (69) = (4 + 1) = 5
        ;     F (70) = 5  ->  F (70) = (5 + 1) = 6
        ;     G (71) = 6  ->  H (72) = (7 + 1) = 8
        ;
        ;       1   3   5   6   8   A   C
        ;       : 2 : 4 :   : 7 : 9 : B :
        ;     ._:_:_:_:_:___:_:_:_:_:_:_:_,
        ;     |  ### ###  |  ### ### ###  |
        ;     |  ### ###  |  ### ### ###  |
        ;     |  ### ###  |  ### ### ###  |
        ;     |  ### ###  |  ### ### ###  |
        ;     |  ### ###  |  ### ### ###  |
        ;     |   |   |   |   |   |   |   |
        ;     | C | D | E | F | G | A | B |
        ;     |___|___|___|___|___|___|___|
        ;       0 : 1 : 2   3 : 4 : 5 : 6
        ;         C#  D#      F#  G#  A#
        ;
        ;   Semi-tones:
        ;       C   ->  1
        ;       C#  ->  2
        ;       D   ->  3
        ;       D#  ->  4
        ;       E   ->  5
        ;       F   ->  6
        ;       F#  ->  7
        ;       G   ->  8
        ;       G#  ->  9
        ;       A   ->  A
        ;       A#  ->  B
        ;       B   ->  C
        ;
        ; ----------------------------------------
_n1         QSET   ASC("JLACEFH", (_n0 - 65)) - 64

        ; Sharp ?
        ;     - Sharp notes are the base note increased by one semi-tone.
        IF (ASC(%n%, 1) = 35)
_n1         QSET    (_n1 + 1)
        ELSE
            ; Minus ?
            IF (ASC(%n%, 1) <> 45)
                ERR "Invalid note"
            ENDI
        ENDI

        ; octave
        ;     - Numeric digit in ASCII Code
        ;     - Range: 0..6 :: ASC('0')..ASC('6')
        ;     - Octave = _o - ASC('0')
        ;              = (_o - 49)
_o            QSET    ASC(%n%, 2)

        IF (_o < 49) OR (_o > 55)
            ERR "Invalid octave"
        ENDI

        ; Put data into output stream
        _OutputEventData(_n1, _o, %i%, %v%, %l%)
ENDM

;; ======================================================================== ;;
;;  _OutputEventData(note, oct, ins, vol, len)                              ;;
;;  Private utility macro to output an event data record.                   ;;
;;                                                                          ;;
;;  ARGUMENTS                                                               ;;
;;      note        The decoded note value.                                 ;;
;;      oct         The note octave (zero-based).                           ;;
;;      ins         The instrument value.                                   ;;
;;      vol         The volume level.                                       ;;
;;      len         The length, in rows (zero-based).                       ;;
;; ======================================================================== ;;
MACRO _OutputEventData(note, oct, ins, vol, len)
        ; Value
        ;     DECLE 1000 0000 0000 0000
        ;     DECLE 0000 0000 00II III0       (I=I-1*3)
        ; ------------------------------
        IF (%ins% <> 0)
_flg        QSET    $8000
        ELSE
_flg        QSET    $0000
        ENDI

        ;         FEDC BA98 7654 3210
        ; Format: fnnn nnnn llll vvvv
        ;         f     = Flag (?)- 0..1
        ;         l     = Length  - 0..F
        ;         v     = Volume  - ~(0..F) (complemented)
        ;         note  = Note    - 0..C
        ;         oct   = Octave  - 1..7
        ; ------------------------------
            DECLE   _flg + (((%note% + (12 * (%oct% - 49))) * $100) + (%len% * $10) + (15 - %vol%))

        IF (_flg <> 0)
            DECLE   ((%ins% - 1) * 3)
        ENDI
ENDM

;; ======================================================================== ;;
;;  _Hex2Dec(var, hex)                                                      ;;
;;  Converts an ASCII character representing a Hexadecimal value, into its  ;;
;;  Decimal counterpart, and assigns it to a symbol.  It validates that the ;;
;;  input is a valid Hexadecimal character.                                 ;;
;;                                                                          ;;
;;  ARGUMENTS                                                               ;;
;;      var         Symbol to hold the output value.                        ;;
;;      hex         Hexadecimal character to convert (0..9; A..F).          ;;
;; ======================================================================== ;;
MACRO _Hex2Dec(var, hex)
;
        IF ((%hex% >= 48) AND (%hex% <= 57))
%var%       QSET    (%hex% - 48)
        ELSE
          IF ((%hex% >= 65) AND (%hex% <= 70))
%var%       QSET    (%hex% - 55)
          ELSE
            ERR "Invalid Hexadecimal digit '%hex%'."
          ENDI
        ENDI
ENDM

;; ======================================================================== ;;
;;  _Chr2Dec(var, chr)                                                      ;;
;;  Converts an ASCII character representing a digit or a letter, into its  ;;
;;  Decimal ordinal value, and assigns it to a symbol.  It validates that   ;;
;;  the input is a valid digit or letter character.                         ;;
;;                                                                          ;;
;;  ARGUMENTS                                                               ;;
;;      var         Symbol to hold the output value.                        ;;
;;      chr         A digit or letter character to convert (0..9; A..Z).    ;;
;; ======================================================================== ;;
MACRO _Chr2Dec(var, chr)
;
        IF ((%chr% >= 48) AND (%chr% <= 57))
%var%       QSET    %chr% - 48
        ELSE
          IF ((%chr% >= 65) AND (%chr% <= 90))
%var%       QSET    %chr% - 55
          ELSE
            ERR "Invalid charater value '%chr%'.  Must be a digit (0..9) or a letter (A..Z)."
          ENDI
        ENDI
ENDM

;; ======================================================================== ;;
;;  _reset_event                                                            ;;
;;  Private macro used by NPK.Note() to reset the state for a new note      ;;
;;  event.                                                                  ;;
;;                                                                          ;;
;;  ARGUMENTS                                                               ;;
;;      None.                                                               ;;
;; ======================================================================== ;;
MACRO   _reset_event
;
_npk.lst    QSET    0
_npk.ins    QSET    0
_npk.vol    QSET    0
_npk.len    QSET    0
_npk.str    QSET    0
ENDM

;; ======================================================================== ;;
;;  _stringify(sym)                                                         ;;
;;  Private utility macro to convert an array symbol back into a literal    ;;
;;  string.                                                                 ;;
;;                                                                          ;;
;;  ARGUMENTS                                                               ;;
;;      sym         The name of the array symbol.                           ;;
;; ======================================================================== ;;
MACRO   _stringify(sym)
    $(%sym%[0, %sym%])
ENDM

;; ======================================================================== ;;
;;  _is_NUL(n)                                                              ;;
;;  Private macro used by NPK.Note() to check whether a note event string   ;;
;;  represents a Null Event (NUL).                                          ;;
;;                                                                          ;;
;;  ARGUMENTS                                                               ;;
;;      n           The note event string, as received by NPK.Note().       ;;
;; ======================================================================== ;;
MACRO   _is_NUL(n)
    ((ASC(%n%, 0) = 78) AND (ASC(%n%, 1) = 85) AND (ASC(%n%, 2) = 76))
ENDM

;; ======================================================================== ;;
;;  _is_DRM(n)                                                              ;;
;;  Private macro used by NPK.Note() to check whether a note event string   ;;
;;  represents a Drum Event (DRM).                                          ;;
;;                                                                          ;;
;;  ARGUMENTS                                                               ;;
;;      n           The note event string, as received by NPK.Note().       ;;
;; ======================================================================== ;;
MACRO   _is_DRM(n)
    ((ASC(%n%, 0) = 68) AND (ASC(%n%, 1) = 82) AND (ASC(%n%, 2) = 77))
ENDM

;; ======================================================================== ;;
;;  _is_new_event(n)                                                        ;;
;;  Private macro used by NPK.Note() to check whether a note event string   ;;
;;  represents a new event.  This is the converse of _is_NUL().             ;;
;;                                                                          ;;
;;  ARGUMENTS                                                               ;;
;;      n           The note event string, as received by NPK.Note().       ;;
;; ======================================================================== ;;
MACRO   _is_new_event(n)
    (NOT _is_NUL(%n%))
ENDM

;; ======================================================================== ;;
;;  _is_change_event(n)                                                     ;;
;;  Private macro used by NPK.Note() to check whether a note event string   ;;
;;  represents an instrument or volume change on the current note event.    ;;
;;                                                                          ;;
;;  ARGUMENTS                                                               ;;
;;      None.                                                               ;;
;; ======================================================================== ;;
MACRO   _is_change_event(i, v)
    (((%i% <> 0) AND (%i% <> _npk.ins)) OR (%v% <> _npk.vol))
ENDM

;; ======================================================================== ;;
;;  End of File:  tracker.mac                                               ;;
;; ======================================================================== ;;

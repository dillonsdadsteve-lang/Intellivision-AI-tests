                                ;@@808_clave:    DRUM($02E, $00, 1, 0, $F)   ; Classic TR-808 Clave:
5997   002E 0000 0038 000F      @@808_clave:    DECLE   $02E, $00, (($39 - 1) - (0 SHL 3)), $F   ; Classic TR-808 Clave:
                                ;               DRUM($02E, $00, 1, 0, $B)   ;   It should really be a sine or triangle wave,
599B   002E 0000 0038 000B                      DECLE   $02E, $00, (($39 - 1) - (0 SHL 3)), $B   ;   It should really be a sine or triangle wave,
                                ;               DRUM($02E, $00, 1, 0, $8)   ;   but beggars can't be choosers ...
599F   002E 0000 0038 0008                      DECLE   $02E, $00, (($39 - 1) - (0 SHL 3)), $8   ;   but beggars can't be choosers ...
                                ;               DRUM($02E, $00, 1, 0, $7)   ;
59A3   002E 0000 0038 0007                      DECLE   $02E, $00, (($39 - 1) - (0 SHL 3)), $7   ;
                                ;               DRUM($02E, $00, 1, 0, $6)   ;   Played on a square wave on something in
59A7   002E 0000 0038 0006                      DECLE   $02E, $00, (($39 - 1) - (0 SHL 3)), $6   ;   Played on a square wave on something in
                                ;               DRUM($02E, $00, 1, 0, $5)   ;   between a D-7 and a D#7 (~2.43 KHz), with an
59AB   002E 0000 0038 0005                      DECLE   $02E, $00, (($39 - 1) - (0 SHL 3)), $5   ;   between a D-7 and a D#7 (~2.43 KHz), with an
                                ;               DRUM($02E, $00, 1, 0, $4)   ;   ultra-fast decay.
59AF   002E 0000 0038 0004                      DECLE   $02E, $00, (($39 - 1) - (0 SHL 3)), $4   ;   ultra-fast decay.
                                ;               DRUM($02E, $00, 1, 0, $4)   ;
59B3   002E 0000 0038 0004                      DECLE   $02E, $00, (($39 - 1) - (0 SHL 3)), $4   ;

                                	SRCFILE "trk-demo.bas",86
                                	;[87] 	'   Include sample song.  Note that assigning a
                                	SRCFILE "trk-demo.bas",87
                                	;[88] 	'   label before including the song allows us to
                                	SRCFILE "trk-demo.bas",88
                                	;[89] 	'   address the structure using VARPTR when we
                                	SRCFILE "trk-demo.bas",89
                                	;[90] 	'   load it.  Otherwise, we would have to dig up
                                	SRCFILE "trk-demo.bas",90
                                	;[91] 	'   its actual address from the assembler's
                                	SRCFILE "trk-demo.bas",91
                                	;[92] 	'   output LISTING file.
                                	SRCFILE "trk-demo.bas",92
                                	;[93] BeatIt:

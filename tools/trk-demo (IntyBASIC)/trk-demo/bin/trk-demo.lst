59B7   002E 0000 0038 0004                      DECLE   $02E, $00, (($39 - 1) - (0 SHL 3)), $4   ;
                                ;               DRUM($02E, $00, 1, 0, $3)   ;
59BB   002E 0000 0038 0003                      DECLE   $02E, $00, (($39 - 1) - (0 SHL 3)), $3   ;
                                ;               DRUM($02E, $00, 1, 0, $3)   ;
59BF   002E 0000 0038 0003                      DECLE   $02E, $00, (($39 - 1) - (0 SHL 3)), $3   ;
                                ;               DRUM($02E, $00, 1, 0, $3)   ;

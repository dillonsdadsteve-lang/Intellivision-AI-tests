                                	;[36] ' =========================================================================
                                	SRCFILE "title.bas",36
                                	;[37] ' Define Functions
                                	SRCFILE "title.bas",37
                                	;[38] '     TextCenterPos(aLength, aRow)
                                	SRCFILE "title.bas",38
                                	;[39] '          Computes the screen position in which to place a string of a
                                	SRCFILE "title.bas",39
                                	;[40] '          given length, in order to center it on a given row.
                                	SRCFILE "title.bas",40
                                	;[41] '
                                	SRCFILE "title.bas",41
                                	;[42] '          Arguments:
                                	SRCFILE "title.bas",42
                                	;[43] '               aLength:  The length of the string, in characters
                                	SRCFILE "title.bas",43
                                	;[44] '               aRow:     The row in which to print the string
                                	SRCFILE "title.bas",44
                                	;[45] '
                                	SRCFILE "title.bas",45
                                	;[46] '     SpritePosX(aColumn, anOffset)
                                	SRCFILE "title.bas",46
                                	;[47] '          Computes the screen position of a sprite on the X axis, given
                                	SRCFILE "title.bas",47
                                	;[48] '          a background column, with an additional displacement value.
                                	SRCFILE "title.bas",48
                                	;[49] '
                                	SRCFILE "title.bas",49
                                	;[50] '          Arguments:
                                	SRCFILE "title.bas",50
                                	;[51] '               aColumn:  The background column to display the sprite
                                	SRCFILE "title.bas",51
                                	;[52] '               anOffset: An additional horizontal displacement offset,
                                	SRCFILE "title.bas",52
                                	;[53] '                         in pixels.
                                	SRCFILE "title.bas",53
                                	;[54] '
                                	SRCFILE "title.bas",54
                                	;[55] '     SpritePosY(aRow, anOffset)
                                	SRCFILE "title.bas",55
                                	;[56] '          Computes the screen position of a sprite on the Y axis, given
                                	SRCFILE "title.bas",56
                                	;[57] '          a background row, with an additional displacement value.
                                	SRCFILE "title.bas",57
                                	;[58] '
                                	SRCFILE "title.bas",58
                                	;[59] '          Arguments:
                                	SRCFILE "title.bas",59
                                	;[60] '               aRow:     The background column to display the sprite
                                	SRCFILE "title.bas",60
                                	;[61] '               anOffset: An additional vertical displacement offset,
                                	SRCFILE "title.bas",61
                                	;[62] '                         in pixels.
                                	SRCFILE "title.bas",62
                                	;[63] ' =========================================================================
                                	SRCFILE "title.bas",63
                                	;[64] DEF FN TextCenterPos(aLength, aRow)  = SCREENPOS(((BACKGROUND_COLUMNS - aLength) / 2), aRow)
                                	SRCFILE "title.bas",64
                                	;[65] DEF FN SpritePosX(aColumn, anOffset) = ((aColumn + 1) * CARD_WIDTH ) + anOffset
                                	SRCFILE "title.bas",65
                                	;[66] DEF FN SpritePosY(aRow, anOffset)    = ((aRow    + 1) * CARD_HEIGHT) + anOffset
                                	SRCFILE "title.bas",66

                                	;FILE lib/bas-interface.bas
                                	;[1] ' =========================================================================
                                	SRCFILE "lib/bas-interface.bas",1
                                	;[2] ' Intellivision Music Tracker - IntyBASIC Interface
                                	SRCFILE "lib/bas-interface.bas",2
                                	;[3] ' =========================================================================
                                	SRCFILE "lib/bas-interface.bas",3
                                	;[4] 
                                	SRCFILE "lib/bas-interface.bas",4
                                	;[5] ' --------------------------------------------------------------
                                	SRCFILE "lib/bas-interface.bas",5
                                	;[6] ' NOTE:
                                	SRCFILE "lib/bas-interface.bas",6
                                	;[7] '   The Intellivision Music Tracker supports either a three- or
                                	SRCFILE "lib/bas-interface.bas",7
                                	;[8] '   six-channel configuration.  The six-channel configuration
                                	SRCFILE "lib/bas-interface.bas",8
                                	;[9] '   takes advantage of the additional PSG in the ECS, and so
                                	SRCFILE "lib/bas-interface.bas",9
                                	;[10] '   requires the expansion module.
                                	SRCFILE "lib/bas-interface.bas",10
                                	;[11] '
                                	SRCFILE "lib/bas-interface.bas",11
                                	;[12] '   The configuration of the tracker is done using symbolic
                                	SRCFILE "lib/bas-interface.bas",12
                                	;[13] '   constants in the file "trk-memmap.asm".  It is recommended
                                	SRCFILE "lib/bas-interface.bas",13
                                	;[14] '   that you use the default configuration unless you really
                                	SRCFILE "lib/bas-interface.bas",14
                                	;[15] '   know what you are doing.
                                	SRCFILE "lib/bas-interface.bas",15
                                	;[16] '
                                	SRCFILE "lib/bas-interface.bas",16
                                	;[17] '   If you disable the six-channel configuration, you must
                                	SRCFILE "lib/bas-interface.bas",17
                                	;[18] '   also change the array sizes below to match.  You must also
                                	SRCFILE "lib/bas-interface.bas",18
                                	;[19] '   ensure that all your song structures conform to the same
                                	SRCFILE "lib/bas-interface.bas",19
                                	;[20] '   configuration or else Bad Things may happen.
                                	SRCFILE "lib/bas-interface.bas",20
                                	;[21] '
                                	SRCFILE "lib/bas-interface.bas",21
                                	;[22] '   Consult the tracker's User Manual & Technical Guide for more
                                	SRCFILE "lib/bas-interface.bas",22
                                	;[23] '   information on the supported configurations.
                                	SRCFILE "lib/bas-interface.bas",23
                                	;[24] ' --------------------------------------------------------------
                                	SRCFILE "lib/bas-interface.bas",24
                                	;[25] 
                                	SRCFILE "lib/bas-interface.bas",25
                                	;[26] ' Support for 3 Channels (Does Not Require ECS)
                                	SRCFILE "lib/bas-interface.bas",26
                                	;[27] '   Const BYTEVAR_SIZE = 21
                                	SRCFILE "lib/bas-interface.bas",27
                                	;[28] '   Const WORDVAR_SIZE =  5
                                	SRCFILE "lib/bas-interface.bas",28
                                	;[29] 
                                	SRCFILE "lib/bas-interface.bas",29
                                	;[30] ' Support for 6 Channels (Requires ECS)
                                	SRCFILE "lib/bas-interface.bas",30
                                	;[31] 	Const BYTEVAR_SIZE = 36
                                	SRCFILE "lib/bas-interface.bas",31
                                	;[32] 	Const WORDVAR_SIZE =  8
                                	SRCFILE "lib/bas-interface.bas",32
                                	;[33] 
                                	SRCFILE "lib/bas-interface.bas",33
                                	;[34] 	' Induce IntyBASIC to enable ECS support
                                	SRCFILE "lib/bas-interface.bas",34
                                	;[35] 	SOUND 5, 0, 0
                                	SRCFILE "lib/bas-interface.bas",35
527B   01C0                     	CLRR R0
527C   0240 00F0                	MVO R0,240
527E   0040                     	SWAP R0
527F   0240 00F4                	MVO R0,244
5281   01C0                     	CLRR R0
5282   0240 00FB                	MVO R0,251
                                	;[36] 
                                	SRCFILE "lib/bas-interface.bas",36
                                	;[37] ' Allocate blocks of RAM for variables
                                	SRCFILE "lib/bas-interface.bas",37
                                	;[38] 	DIM  TRK_BYTEVAR( BYTEVAR_SIZE )
                                	SRCFILE "lib/bas-interface.bas",38
                                	;[39] 	DIM #TRK_WORDVAR( WORDVAR_SIZE )
                                	SRCFILE "lib/bas-interface.bas",39
                                	;[40] 
                                	SRCFILE "lib/bas-interface.bas",40
                                	;[41] ' Set up the global configuration
                                	SRCFILE "lib/bas-interface.bas",41
                                	;[42]     ASM INCLUDE "lib/global-config.asm"
                                	SRCFILE "lib/bas-interface.bas",42
                                 INCLUDE "lib/global-config.asm"
                                ;* ======================================================================== *;
                                ;*  These routines are placed into the public domain by their authors.  All *;
                                ;*  copyright rights are hereby relinquished on the routines and data in    *;
                                ;*  this file.  -- Arnauld Chevallier, 2008; James Pujals, 2017             *;
                                ;* ======================================================================== *;

                                ;; ======================================================================== ;;
                                ;;  GLOBAL TRACKER CONFIGURATION                                            ;;
                                ;; ------------------------------------------------------------------------ ;;
                                ;;  WARNING:                                                                ;;
                                ;;      The tracker library supports a configuration of either 3-channels   ;;
                                ;;      or 6-channels, set at assembly time via the assembler symbol        ;;
                                ;;      "TRK_ENABLED_6_CHN" as defined below:                               ;;
                                ;;                                                                          ;;
                                ;;          TRK_ENABLED_6_CHN = 0   : 3-channels                            ;;
                                ;;          TRK_ENABLED_6_CHN = 1   : 6-channels                            ;;
                                ;;                                                                          ;;
                                ;;      Consequently, if you opt for 3-channels support, you must make sure ;;
                                ;;      that your music data includes only three channels per pattern       ;;
                                ;;      definition, or else Bad Things will happen.                         ;;
                                ;;                                                                          ;;
                                ;;      Also, when defining your song's drums and pitch effects, be sure to ;;
                                ;;      use the correct number steps specified in the constants below, or   ;;
                                ;;      else more Bad Things will happen.                                   ;;
                                ;;                                                                          ;;
                                ;;      YOU HAVE BEEN WARNED.                                               ;;
                                ;; ======================================================================== ;;
0x1                             TRK_ENABLED_6_CHN       EQU     1           ; Enable six channels
0x0                             TRK_GLOBAL_FADER        EQU     0           ; Global volume attenuator
0x10                            TRK_DRUM_STEPS          EQU     16          ; Number of steps in drums
0x0                             TRK_ENABLE_LONG_DRUMS   EQU     0           ; Enable long drums
0x4                             TRK_PITCH_FX_STEPS      EQU     4           ; Number of steps in pitch effects
0x8                             TRK_ENV_REWIND_COUNT    EQU     8           ; Number of steps to rewind the envelope

                                ;; ======================================================================== ;;
                                ;;  DEFINITIONS:                                                            ;;
                                ;; ------------------------------------------------------------------------ ;;
                                ;;      TRK_ENABLED_6_CHN                                                   ;;
                                ;;          Indicates whether the tracker should support 3 or 6 channel     ;;
                                ;;          songs.  Note that the tracker will play 6 channels whether the  ;;
                                ;;          ECS is available or not, but they won't be heard unless it is.  ;;
                                ;;              Values:                                                     ;;
                                ;;                  1:          6 channels enabled (default)                ;;
                                ;;                  0:          6 channels disabled                         ;;
                                ;;                                                                          ;;
                                ;;      TRK_GLOBAL_FADER                                                    ;;
                                ;;          Defines a default volume attenuation to apply to songs.  The    ;;
                                ;;          song's master volume will be reduced by this amount as it plays.;;
                                ;;              Values:                                                     ;;
                                ;;                  0:          No attenuation (normal song volume)         ;;
                                ;;                  1 to 15:    Amount to attenuate master volume.          ;;
                                ;;                                                                          ;;
                                ;;      TRK_DRUM_STEPS                                                      ;;
                                ;;          The number of steps that define a drum instrument.  Each step   ;;
                                ;;          corresponds to a "tick" of the music tracker.                   ;;
                                ;;              Values:                                                     ;;
                                ;;                  1 to 255:   Number of steps to play a drum sound.       ;;
                                ;;                                                                          ;;
                                ;;      TRK_ENABLE_LONG_DRUMS                                               ;;
                                ;;          Indicates whether "long drums" are enabled.  Long drums play    ;;
                                ;;          each step for two ticks instead of one, doubling the length     ;;
                                ;;          of the drum sound.                                              ;;
                                ;;              Values:                                                     ;;
                                ;;                  1:          Long drums enabled                          ;;
                                ;;                  0:          Long drums disabled (default)               ;;
                                ;;                                                                          ;;
                                ;;      TRK_PITCH_FX_STEPS                                                  ;;
                                ;;          Similar to TRK_DRUM_STEPS, this value indicates the number of   ;;
                                ;;          steps that define a pitch effect, i.e., the number of semi-tone ;;
                                ;;          changes to repeat for each arpeggio.  Each step corresponds to  ;;
                                ;;          a "tick" of the music tracker.                                  ;;
                                ;;              Values:                                                     ;;
                                ;;                  4 to 256:   Must be a power of two.                     ;;
                                ;;                                                                          ;;
                                ;;      TRK_ENV_REWIND_COUNT                                                ;;
                                ;;          Indicates the number of steps to backtrack when an instrument   ;;
                                ;;          envelope is exhausted while a note is sustained.  This allows   ;;
                                ;;          for long notes to play indefinitely.  Each step corresponds to  ;;
                                ;;          an envelope sample point.                                       ;;
                                ;;              Values:                                                     ;;
                                ;;                  0 to 63:    Number of samples to backtrack envelope.    ;;
                                ;;                                                                          ;;
                                ;; ======================================================================== ;;

0xF000                          TRK_END_SONG        EQU     $F000   ; Marks the end of a song

                                        ; Determine the number of tracks to process
                                        IF (TRK_ENABLED_6_CHN)
0x6                             TRK_MAX_CHANNELS    EQU     6
                                        ELSE
                                TRK_MAX_CHANNELS    EQU     3
                                        ENDI

                                ;; ======================================================================== ;;
                                ;;  End of File:  global-config.asm                                         ;;
                                ;; ======================================================================== ;;
                                	;[43] 
                                	SRCFILE "lib/bas-interface.bas",43
                                	;[44] ' Include the Intellivision Music Tracker library
                                	SRCFILE "lib/bas-interface.bas",44
                                	;[45] 	ASM INCLUDE "lib/bas-memmap.asm"
                                	SRCFILE "lib/bas-interface.bas",45
                                 INCLUDE "lib/bas-memmap.asm"
                                ;* ======================================================================== *;
                                ;*  These routines are placed into the public domain by their authors.  All *;
                                ;*  copyright rights are hereby relinquished on the routines and data in    *;
                                ;*  this file.  -- James Pujals, 2020                                       *;
                                ;* ======================================================================== *;

                                ;; ======================================================================== ;;
                                ;;  MEMORY ALLOCATION FOR TRACKER                                           ;;
                                ;;                                                                          ;;
                                ;;  WARNING:                                                                ;;
                                ;;      Do not change the order of these variables!  The tracker computes   ;;
                                ;;      offsets between them to optimize memory access.  The sign of these  ;;
                                ;;      offsets depends on the relative position of the addresses, and will ;;
                                ;;      break the tracker if wrong.                                         ;;
                                ;;                                                                          ;;
                                ;;      YOU HAVE BEEN WARNED.                                               ;;
                                ;; ======================================================================== ;;

0x0                             _trk.idx    QSET    0

                                ;; ======================================================================== ;;
                                MACRO   _resetidx
                                ;
                                _trk.idx    QSET 0
                                ENDM

                                ;; ======================================================================== ;;
                                MACRO   _nextidx
                                    _trk.idx
                                _trk.idx    QSET (_trk.idx + 1)
                                ENDM

                                ;; ======================================================================== ;;
                                ;;  RAM REQUIREMENTS                                                        ;;
                                ;;      The tracker library relies on a number of internal data structures  ;;
                                ;;      to synthesize instrument sounds and to keep track of music patterns ;;
                                ;;      and note placements as it plays.  The number of variables depends   ;;
                                ;;      on the channel configuration. Note that the 6-channel configuration ;;
                                ;;      requires more memory.                                               ;;
                                ;;                                                                          ;;
                                ;;      3 Channels:                                                         ;;
                                ;;           5  16-bit (System) RAM                                         ;;
                                ;;          20  8-bit (Scratch) RAM                                         ;;
                                ;;                                                                          ;;
                                ;;      6 Channels:                                                         ;;
                                ;;           8  16-bit (System) RAM                                         ;;
                                ;;          35  8-bit (Scratch) RAM                                         ;;
                                ;;                                                                          ;;
                                ;;      The variables are defined in IntyBASIC as arrays, and the macros    ;;
                                ;;      below serve to map their addresses to the symbolic labels utilized  ;;
                                ;;      by the tracker routines.                                            ;;
                                ;;                                                                          ;;
                                ;;      The reason this is necessary is because IntyBASIC defines all its   ;;
                                ;;      variable symbols at the end of the program, and so they are not     ;;
                                ;;      available to the assembler pre-processor.  Wrapping them in macros  ;;
                                ;;      allows the assembler to resolve them on its second pass.            ;;
                                ;; ======================================================================== ;;


                                ;               _resetidx
                                                ;
0x0                             _trk.idx    QSET 0
                                ;CHN_STATE       EQU     _nextidx       ; Channel active state
0x0                             CHN_STATE       EQU     _trk.idx
0x1                             _trk.idx    QSET (_trk.idx + 1)       ; Channel active state
                                ;MASTER_FADER    EQU     _nextidx
0x1                             MASTER_FADER    EQU     _trk.idx
0x2                             _trk.idx    QSET (_trk.idx + 1)

0x2                             TRK_BYTEVAR.START EQU   _trk.idx

                                ;REF_M           EQU     _nextidx       ; Global song refresh counter (counts down to next row)
0x2                             REF_M           EQU     _trk.idx
0x3                             _trk.idx    QSET (_trk.idx + 1)       ; Global song refresh counter (counts down to next row)
                                ;COUNT_M         EQU     _nextidx       ; Global music counter
0x3                             COUNT_M         EQU     _trk.idx
0x4                             _trk.idx    QSET (_trk.idx + 1)       ; Global music counter
                                ;COUNT_P         EQU     _nextidx       ; Pattern counter (counts down pattern length)
0x4                             COUNT_P         EQU     _trk.idx
0x5                             _trk.idx    QSET (_trk.idx + 1)       ; Pattern counter (counts down pattern length)
                                ;PAT             EQU     _nextidx       ; Index of current pattern in patterns table
0x5                             PAT             EQU     _trk.idx
0x6                             _trk.idx    QSET (_trk.idx + 1)       ; Index of current pattern in patterns table

                                ; CHANNEL NOTES:
                                ; ------------------------------
                                ;NOTE_A          EQU     _nextidx       ; Current Channel A note
0x6                             NOTE_A          EQU     _trk.idx
0x7                             _trk.idx    QSET (_trk.idx + 1)       ; Current Channel A note
                                ;NOTE_B          EQU     _nextidx       ; Current Channel B note
0x7                             NOTE_B          EQU     _trk.idx
0x8                             _trk.idx    QSET (_trk.idx + 1)       ; Current Channel B note
                                ;NOTE_C          EQU     _nextidx       ; Current Channel C note
0x8                             NOTE_C          EQU     _trk.idx
0x9                             _trk.idx    QSET (_trk.idx + 1)       ; Current Channel C note

                                    IF (TRK_ENABLED_6_CHN)
                                ;NOTE_D          EQU     _nextidx       ; Current Channel D note
0x9                             NOTE_D          EQU     _trk.idx
0xA                             _trk.idx    QSET (_trk.idx + 1)       ; Current Channel D note
                                ;NOTE_E          EQU     _nextidx       ; Current Channel E note
0xA                             NOTE_E          EQU     _trk.idx
0xB                             _trk.idx    QSET (_trk.idx + 1)       ; Current Channel E note
                                ;NOTE_F          EQU     _nextidx       ; Current Channel F note
0xB                             NOTE_F          EQU     _trk.idx
0xC                             _trk.idx    QSET (_trk.idx + 1)       ; Current Channel F note
                                    ENDI

                                ; CHANNEL NOTE COUNTERS
                                ; ------------------------------
                                ;REF_A           EQU     _nextidx       ; Channel A note refresh counter (<< 4: counts down to next note event)
0xC                             REF_A           EQU     _trk.idx
0xD                             _trk.idx    QSET (_trk.idx + 1)       ; Channel A note refresh counter (<< 4: counts down to next note event)
                                ;REF_B           EQU     _nextidx       ; Channel B note refresh counter (<< 4: counts down to next note event)
0xD                             REF_B           EQU     _trk.idx
0xE                             _trk.idx    QSET (_trk.idx + 1)       ; Channel B note refresh counter (<< 4: counts down to next note event)
                                ;REF_C           EQU     _nextidx       ; Channel C note refresh counter (<< 4: counts down to next note event)
0xE                             REF_C           EQU     _trk.idx
0xF                             _trk.idx    QSET (_trk.idx + 1)       ; Channel C note refresh counter (<< 4: counts down to next note event)

                                    IF (TRK_ENABLED_6_CHN)
                                ;REF_D           EQU     _nextidx       ; Channel D note refresh counter (<< 4: counts down to next note event)
0xF                             REF_D           EQU     _trk.idx
0x10                            _trk.idx    QSET (_trk.idx + 1)       ; Channel D note refresh counter (<< 4: counts down to next note event)
                                ;REF_E           EQU     _nextidx       ; Channel E note refresh counter (<< 4: counts down to next note event)
0x10                            REF_E           EQU     _trk.idx
0x11                            _trk.idx    QSET (_trk.idx + 1)       ; Channel E note refresh counter (<< 4: counts down to next note event)
                                ;REF_F           EQU     _nextidx       ; Channel F note refresh counter (<< 4: counts down to next note event)
0x11                            REF_F           EQU     _trk.idx
0x12                            _trk.idx    QSET (_trk.idx + 1)       ; Channel F note refresh counter (<< 4: counts down to next note event)
                                    ENDI

                                ; CHANNEL VOLUME:
                                ; ------------------------------
                                ;VOL_A           EQU     _nextidx       ; Channel A volume (complemented: ~(Volume))
0x12                            VOL_A           EQU     _trk.idx
0x13                            _trk.idx    QSET (_trk.idx + 1)       ; Channel A volume (complemented: ~(Volume))
                                ;VOL_B           EQU     _nextidx       ; Channel B volume (complemented: ~(Volume))
0x13                            VOL_B           EQU     _trk.idx
0x14                            _trk.idx    QSET (_trk.idx + 1)       ; Channel B volume (complemented: ~(Volume))
                                ;VOL_C           EQU     _nextidx       ; Channel C volume (complemented: ~(Volume))
0x14                            VOL_C           EQU     _trk.idx
0x15                            _trk.idx    QSET (_trk.idx + 1)       ; Channel C volume (complemented: ~(Volume))

                                    IF (TRK_ENABLED_6_CHN)
                                ;VOL_D           EQU     _nextidx       ; Channel D volume (complemented: ~(Volume))
0x15                            VOL_D           EQU     _trk.idx
0x16                            _trk.idx    QSET (_trk.idx + 1)       ; Channel D volume (complemented: ~(Volume))
                                ;VOL_E           EQU     _nextidx       ; Channel E volume (complemented: ~(Volume))
0x16                            VOL_E           EQU     _trk.idx
0x17                            _trk.idx    QSET (_trk.idx + 1)       ; Channel E volume (complemented: ~(Volume))
                                ;VOL_F           EQU     _nextidx       ; Channel F volume (complemented: ~(Volume))
0x17                            VOL_F           EQU     _trk.idx
0x18                            _trk.idx    QSET (_trk.idx + 1)       ; Channel F volume (complemented: ~(Volume))
                                    ENDI

                                ; CHANNEL INSTRUMENTS:
                                ; ------------------------------
                                ;INSTR_A         EQU     _nextidx       ; Current Channel A instrument
0x18                            INSTR_A         EQU     _trk.idx
0x19                            _trk.idx    QSET (_trk.idx + 1)       ; Current Channel A instrument
                                ;INSTR_B         EQU     _nextidx       ; Current Channel B instrument
0x19                            INSTR_B         EQU     _trk.idx
0x1A                            _trk.idx    QSET (_trk.idx + 1)       ; Current Channel B instrument
                                ;INSTR_C         EQU     _nextidx       ; Current Channel C instrument
0x1A                            INSTR_C         EQU     _trk.idx
0x1B                            _trk.idx    QSET (_trk.idx + 1)       ; Current Channel C instrument

                                    IF (TRK_ENABLED_6_CHN)
                                ;INSTR_D         EQU     _nextidx       ; Current Channel D instrument
0x1B                            INSTR_D         EQU     _trk.idx
0x1C                            _trk.idx    QSET (_trk.idx + 1)       ; Current Channel D instrument
                                ;INSTR_E         EQU     _nextidx       ; Current Channel E instrument
0x1C                            INSTR_E         EQU     _trk.idx
0x1D                            _trk.idx    QSET (_trk.idx + 1)       ; Current Channel E instrument
                                ;INSTR_F         EQU     _nextidx       ; Current Channel F instrument
0x1D                            INSTR_F         EQU     _trk.idx
0x1E                            _trk.idx    QSET (_trk.idx + 1)       ; Current Channel F instrument
                                    ENDI

                                ; CHANNEL LOCAL COUNTER
                                ; ------------------------------
                                ;COUNT_A         EQU     _nextidx       ; Channel A counter local counter (counts $00..$FF, or until note duration, for use by pitch effects)
0x1E                            COUNT_A         EQU     _trk.idx
0x1F                            _trk.idx    QSET (_trk.idx + 1)       ; Channel A counter local counter (counts $00..$FF, or until note duration, for use by pitch effects)
                                ;COUNT_B         EQU     _nextidx       ; Channel B counter local counter (counts $00..$FF, or until note duration, for use by pitch effects)
0x1F                            COUNT_B         EQU     _trk.idx
0x20                            _trk.idx    QSET (_trk.idx + 1)       ; Channel B counter local counter (counts $00..$FF, or until note duration, for use by pitch effects)
                                ;COUNT_C         EQU     _nextidx       ; Channel C counter local counter (counts $00..$FF, or until note duration, for use by pitch effects)
0x20                            COUNT_C         EQU     _trk.idx
0x21                            _trk.idx    QSET (_trk.idx + 1)       ; Channel C counter local counter (counts $00..$FF, or until note duration, for use by pitch effects)

                                    IF (TRK_ENABLED_6_CHN)
                                ;COUNT_D         EQU     _nextidx       ; Channel E counter local counter (counts $00..$FF, or until note duration, for use by pitch effects)
0x21                            COUNT_D         EQU     _trk.idx
0x22                            _trk.idx    QSET (_trk.idx + 1)       ; Channel E counter local counter (counts $00..$FF, or until note duration, for use by pitch effects)
                                ;COUNT_E         EQU     _nextidx       ; Channel E counter local counter (counts $00..$FF, or until note duration, for use by pitch effects)
0x22                            COUNT_E         EQU     _trk.idx
0x23                            _trk.idx    QSET (_trk.idx + 1)       ; Channel E counter local counter (counts $00..$FF, or until note duration, for use by pitch effects)
                                ;COUNT_F         EQU     _nextidx       ; Channel F counter local counter (counts $00..$FF, or until note duration, for use by pitch effects)
0x23                            COUNT_F         EQU     _trk.idx
0x24                            _trk.idx    QSET (_trk.idx + 1)       ; Channel F counter local counter (counts $00..$FF, or until note duration, for use by pitch effects)
                                    ENDI

0x22                            TRK_BYTEVAR.SIZE EQU    (_trk.idx - TRK_BYTEVAR.START)

                                ; GLOBAL TRACKER CONFIGURATION:
                                ; ------------------------------
                                ;               _resetidx
                                                ;
0x0                             _trk.idx    QSET 0
                                ;SONG            EQU     _nextidx       ; Pointer to song
0x0                             SONG            EQU     _trk.idx
0x1                             _trk.idx    QSET (_trk.idx + 1)       ; Pointer to song
                                ;INS_PTR         EQU     _nextidx       ; Pointer to instruments table
0x1                             INS_PTR         EQU     _trk.idx
0x2                             _trk.idx    QSET (_trk.idx + 1)       ; Pointer to instruments table

                                ; CHANNEL PATTERN POSITIONS:
                                ; ------------------------------
                                ;POS_A           EQU     _nextidx       ; Current pattern position of Channel A
0x2                             POS_A           EQU     _trk.idx
0x3                             _trk.idx    QSET (_trk.idx + 1)       ; Current pattern position of Channel A
                                ;POS_B           EQU     _nextidx       ; Current pattern position of Channel B
0x3                             POS_B           EQU     _trk.idx
0x4                             _trk.idx    QSET (_trk.idx + 1)       ; Current pattern position of Channel B
                                ;POS_C           EQU     _nextidx       ; Current pattern position of Channel C
0x4                             POS_C           EQU     _trk.idx
0x5                             _trk.idx    QSET (_trk.idx + 1)       ; Current pattern position of Channel C

                                    IF (TRK_ENABLED_6_CHN)
                                ;POS_D           EQU     _nextidx       ; Current pattern position of Channel D
0x5                             POS_D           EQU     _trk.idx
0x6                             _trk.idx    QSET (_trk.idx + 1)       ; Current pattern position of Channel D
                                ;POS_E           EQU     _nextidx       ; Current pattern position of Channel E
0x6                             POS_E           EQU     _trk.idx
0x7                             _trk.idx    QSET (_trk.idx + 1)       ; Current pattern position of Channel E
                                ;POS_F           EQU     _nextidx       ; Current pattern position of Channel F
0x7                             POS_F           EQU     _trk.idx
0x8                             _trk.idx    QSET (_trk.idx + 1)       ; Current pattern position of Channel F
                                    ENDI

                                ;; ======================================================================== ;;
                                ;; Primary PSG in the main console.                                         ;;
                                ;; ======================================================================== ;;
0x1F0                           PSG0            STRUCT  $01F0

                                                ;;----------------------------------------------------------;;
                                                ;; Register address definitions                             ;;
                                                ;;----------------------------------------------------------;;
0x1F0                           @@chn_a_lo      QEQU    $ + 0   ; Channel A period, lower 8 bits of 12
0x1F1                           @@chn_b_lo      QEQU    $ + 1   ; Channel B period, lower 8 bits of 12
0x1F2                           @@chn_c_lo      QEQU    $ + 2   ; Channel C period, lower 8 bits of 12

0x1F8                           @@chan_enable   QEQU    $ + 8   ; Channel enables (bits 3-5 noise, 0-2 tone)
                                                ENDS

                                ;; ======================================================================== ;;
                                ;; Secondary PSG in the expansion unit.                                     ;;
                                ;; ======================================================================== ;;
0xF0                            PSG1            STRUCT  $00F0

                                                ;;----------------------------------------------------------;;
                                                ;; Register address definitions                             ;;
                                                ;;----------------------------------------------------------;;
0xF0                            @@chn_a_lo      QEQU    $ + 0   ; Channel A period, lower 8 bits of 12
0xF1                            @@chn_b_lo      QEQU    $ + 1   ; Channel B period, lower 8 bits of 12
0xF2                            @@chn_c_lo      QEQU    $ + 2   ; Channel C period, lower 8 bits of 12

0xF8                            @@chan_enable   QEQU    $ + 8   ; Channel enables (bits 3-5 noise, 0-2 tone)
                                                ENDS


                                ;; ======================================================================== ;;
                                ;;  End of File:  bas-memmap.asm                                            ;;
                                ;; ======================================================================== ;;
                                	;[46] 	ASM INCLUDE "lib/tracker.mac"
                                	SRCFILE "lib/bas-interface.bas",46
                                 INCLUDE "lib/tracker.mac"
                                ;* ======================================================================== *;
                                ;*  These routines are placed into the public domain by their authors.  All *;
                                ;*  copyright rights are hereby relinquished on the routines and data in    *;
                                ;*  this file.  -- Arnauld Chevallier, 2008; James Pujals, 2020             *;
                                ;* ======================================================================== *;

0x0                             _npk        STRUCT  0
0x0                             @@lst       QSET    0
0x0                             @@ins       QSET    0
0x0                             @@vol       QSET    0
0x0                             @@len       QSET    0
0x0                             @@str       QSET    0

0x0                             @@rows      QSET    0
0x0                             @@count     QSET    0
0x0                             @@open      QSET    0
                                            ENDS

                                ;; ======================================================================== ;;
                                ;;  DRUM(t_per, n_per, tone, noise, vol)                                    ;;
                                ;;  Defines a drum sample record.                                           ;;
                                ;;                                                                          ;;
                                ;;  ARGUMENTS                                                               ;;
                                ;;      t_per       PSG tone period.                                        ;;
                                ;;      n_per       PSG noise period.                                       ;;
                                ;;      tone        Enable tone flag (1 = on; 0 = off).                     ;;
                                ;;      noise       Enable noise flag (1 = on; 0 = off).                    ;;
                                ;;      vol         Volume level (0..15).                                   ;;
                                ;; ======================================================================== ;;
                                MACRO DRUM(t_per, n_per, tone, noise, vol)
                                            DECLE   %t_per%, %n_per%, (($39 - %tone%) - (%noise% SHL 3)), %vol%
                                ENDM

                                ;; ======================================================================== ;;
                                ;;  NOTES(n0, n1, n2, n3)                                                   ;;
                                ;;  Defines four note events at once.  This macro calls NOTES() four times. ;;
                                ;;                                                                          ;;
                                ;;  ARGUMENTS                                                               ;;
                                ;;      n0          Row event string #0.                                    ;;
                                ;;      n1          Row event string #1.                                    ;;
                                ;;      n2          Row event string #2.                                    ;;
                                ;;      n3          Row event string #3.                                    ;;
                                ;; ======================================================================== ;;
                                MACRO NOTES(n0, n1, n2, n3)
                                ;
                                    LISTING "code"

                                        NOTE(%n0%)
                                        NOTE(%n1%)
                                        NOTE(%n2%)
                                        NOTE(%n3%)

                                    LISTING "prev"
                                ENDM

                                ;; ======================================================================== ;;
                                ;;  NOTE(n)                                                                 ;;
                                ;;  Defines a note event record.  The format for the event string is:       ;;
                                ;;      "NnO IVL"                                                           ;;
                                ;;  Where each token represents:                                            ;;
                                ;;    N = Note (C, D, E, F, G, A, B)                                        ;;
                                ;;    n = '-' or '#'                                                        ;;
                                ;;    O = Octave (1 to 7)                                                   ;;
                                ;;    I = new Instrument (1 to F, or 0 for unchanged)                       ;;
                                ;;    V = Volume (0 to F)                                                   ;;
                                ;;    L = Length (0 to F)                                                   ;;
                                ;;                                                                          ;;
                                ;;    The following strings can be used instead of the "NnO" parameters:    ;;
                                ;;      "DRM" --> Drum event: invokes a drum.                               ;;
                                ;;      "NUL" --> Null event: no note change.                               ;;
                                ;;                                                                          ;;
                                ;;    Examples:                                                             ;;
                                ;;      "C-3 1F1", "D#4 0F1", "DRM 1F1", "NUL 0F1"                          ;;
                                ;;                                                                          ;;
                                ;;  ARGUMENTS                                                               ;;
                                ;;      n           Row event string in the format "NnO IVL".               ;;
                                ;; ======================================================================== ;;
                                MACRO NOTE(n)
                                ;
                                    LISTING "code"

                                        IF (STRLEN(%n%) > 0)

                                _Chr2Dec(_i, ASC(%n%, 4))           ; _i = Instrument
                                _Hex2Dec(_v, ASC(%n%, 5))           ; _v = Volume
                                _Hex2Dec(_l, ASC(%n%, 6))           ; _l = Length

                                            _RenderEvent(%n%, _i, _v, _l)

                                        ENDI

                                    LISTING "prev"
                                ENDM

                                ;; ======================================================================== ;;
                                ;;  NPK.Begin(rows)                                                         ;;
                                ;;  Opens a new NPK pattern.  NPK patterns are defined as a series of       ;;
                                ;;  discrete rows, similar to the NOTE() macro, but automatically packed    ;;
                                ;;  into event records.                                                     ;;
                                ;;                                                                          ;;
                                ;;  If a number of rows is given, it will also validate that the total      ;;
                                ;;  number of rows collected for all events is exactly the expected value.  ;;
                                ;;                                                                          ;;
                                ;;  NPK patterns are very useful for defining drum tracks, which are easier ;;
                                ;;  to visualize as individual events placed on a linear scale of discrete  ;;
                                ;;  rows.                                                                   ;;
                                ;;                                                                          ;;
                                ;;  For example, the following NPK pattern represents two drum hits lasting ;;
                                ;;  four rows each, for a total of 8 rows for the entire pattern:           ;;
                                ;;                                                                          ;;
                                ;;      NPK.Begin(8)                                                        ;;
                                ;;        NPK.Note("DRM 1F0")                                               ;;
                                ;;        NPK.Note("NUL 0F0")                                               ;;
                                ;;        NPK.Note("NUL 0F0")                                               ;;
                                ;;                                                                          ;;
                                ;;        NPK.Note("DRM 2F0")                                               ;;
                                ;;        NPK.Note("NUL 0F0")                                               ;;
                                ;;        NPK.Note("NUL 0F0")                                               ;;
                                ;;      NPK.End                                                             ;;
                                ;;                                                                          ;;
                                ;;  It will be packed as if it were enter in this way:                      ;;
                                ;;                                                                          ;;
                                ;;      NOTE("DRM 1F3")                                                     ;;
                                ;;      NOTE("DRM 2F3")                                                     ;;
                                ;;                                                                          ;;
                                ;;  Thus, listing all the individual rows discretely makes it is easier to  ;;
                                ;;  visualize the full scope of the pattern, allowing you to add syncopated ;;
                                ;;  accents, etc. while maintaining the beat.                               ;;
                                ;;                                                                          ;;
                                ;;  NOTE:                                                                   ;;
                                ;;      NPK patterns must be opened with the NPK.Begin() directive, and     ;;
                                ;;      closed with the NPK.End directive.                                  ;;
                                ;;                                                                          ;;
                                ;;  ARGUMENTS                                                               ;;
                                ;;      rows        Number of rows expected in pattern, or zero to suppress ;;
                                ;;                  length validation.                                      ;;
                                ;; ======================================================================== ;;
                                MACRO   NPK.Begin(rows)
                                ;
                                    LISTING "off"

                                        IF (_npk.open <> 0)
                                            ERR "NPK pattern block already open!  Open NPK patterns must first be closed with 'NPK.End'."
                                        ELSE
                                            _reset_event

                                _npk.open   QSET    1
                                _npk.count  QSET    0
                                _npk.rows   QSET    %rows%
                                        ENDI

                                    LISTING "prev"
                                ENDM

                                ;; ======================================================================== ;;
                                ;;  NPK.End                                                                 ;;
                                ;;  Closes an open NPK pattern.  See NPK.Begin() for more information on    ;;
                                ;;  NPK patterns.                                                           ;;
                                ;;                                                                          ;;
                                ;;  NOTE:                                                                   ;;
                                ;;      NPK patterns must be opened with the NPK.Begin() directive, and     ;;
                                ;;      closed with the NPK.End directive.                                  ;;
                                ;;                                                                          ;;
                                ;;  ARGUMENTS                                                               ;;
                                ;;      None.                                                               ;;
                                ;; ======================================================================== ;;
                                MACRO   NPK.End
                                ;
                                    LISTING "code"

                                        IF (_npk.open = 0)
                                            ERR "NPK pattern block not open!  NPK patterns must first be opened with 'NPK.Begin'."
                                        ELSE
                                          IF (_npk.str <> 0)
                                            _RenderEvent(_stringify(_npk.str), _npk.ins, _npk.vol, (_npk.len - 1))
                                          ENDI

                                          ; If row count validation is enabled, enforce it.
                                          IF (_npk.rows > 0)
                                            IF (_npk.count > _npk.rows)
                                                ERR $("Too many rows in pattern. ", $#(_npk.rows), " expected, ", $#(_npk.count), " found.")
                                            ENDI

                                            IF (_npk.count < _npk.rows)
                                                ERR $("Too few rows in pattern. ",  $#(_npk.rows), " expected, ", $#(_npk.count), " found.")
                                            ENDI
                                          ENDI

                                            _reset_event

                                _npk.count  QSET    0
                                _npk.rows   QSET    0
                                _npk.open   QSET    0
                                        ENDI

                                    LISTING "prev"
                                ENDM

                                ;; ======================================================================== ;;
                                ;;  NPK.Note(n)                                                             ;;
                                ;;  Defines a discrete event row as part of an NPK pattern. See NPK.Begin() ;;
                                ;;  for more information on NPK patterns.                                   ;;
                                ;;                                                                          ;;
                                ;;  The format of the argument is the same as that of the NOTE() macro:     ;;
                                ;;      "NnO IVL"                                                           ;;
                                ;;  Where each token represents:                                            ;;
                                ;;    N = Note (C, D, E, F, G, A, B)                                        ;;
                                ;;    n = '-' or '#'                                                        ;;
                                ;;    O = Octave (1 to 7)                                                   ;;
                                ;;    I = new Instrument (1 to F, or 0 for unchanged)                       ;;
                                ;;    V = Volume (0 to F)                                                   ;;
                                ;;    L = Length (0 to F)                                                   ;;
                                ;;                                                                          ;;
                                ;;    The following strings can be used instead of the "NnO" parameters:    ;;
                                ;;      "DRM" --> Drum event: invokes a drum.                               ;;
                                ;;      "NUL" --> Null event: no note change.                               ;;
                                ;;                                                                          ;;
                                ;;    Examples:                                                             ;;
                                ;;      "C-3 1F1", "D#4 0F1", "DRM 1F1", "NUL 0F1"                          ;;
                                ;;                                                                          ;;
                                ;;  ARGUMENTS                                                               ;;
                                ;;      n           Row event string in the format "NnO IVL".               ;;
                                ;; ======================================================================== ;;
                                MACRO   NPK.Note(n)
                                ;
                                    LISTING "code"

                                      IF (_npk.open = 0)
                                        ERR "NPK pattern block not open!  NPK patterns must first be opened with 'NPK.Begin'."
                                      ELSE

                                        IF (STRLEN(%n%) > 0)

                                          ; Decode tokens
                                _Chr2Dec(_i, ASC(%n%, 4))                       ; _i = Instrument
                                _Hex2Dec(_v, ASC(%n%, 5))                       ; _v = Volume
                                _Hex2Dec(_l, ASC(%n%, 6))                       ; _l = Length

                                          ; Verify that DRUM events have a valid
                                          ; instrument number.
                                          IF _is_DRM(%n%)
                                            IF ((_i = 0) OR (_i > 127))
                                                ERR $("Invalid drum instrument '", $#(_i), "'.  Drum instruments must be a value between 1 and 127.")
                                            ENDI
                                          ENDI

                                _new        QSET    0
                                _l          QSET    (_l + 1)                    ; Convert length into one-based
                                _npk.count  QSET    (_npk.count + _l)           ; Count all rows processed

                                          ; Note that for the purposes of pattern
                                          ; composition, the very first row is
                                          ; considered a new event, even if it is
                                          ; a Null Event (NUL).
                                          IF (_is_new_event(%n%) OR (_npk.str = 0))
                                _new        QSET    1
                                          ELSE

                                            ; If the instrument or volume changed,
                                            ; register a new event.
                                            IF _is_change_event(_i, _v)
                                _new        QSET    1

                                            ; Otherwise, extend the previous one.
                                            ELSE
                                _newlen     QSET    (_npk.len + _l)

                                                ; Check if the length overflows, and
                                                ; if so, split it into a new event.
                                                IF (_newlen > 16)
                                _npk.len    QSET    16                          ; Cap the length of an event to 15 rows
                                _l          QSET    (_newlen - _npk.len)
                                _new        QSET    1
                                                ENDI
                                            ENDI

                                          ENDI

                                          ; Keep track of new event ...
                                          IF (_new)

                                            ; Post previous event if we have one
                                            IF (_npk.str <> 0)

                                              ; For non-drum events, only emit the
                                              ; instrument if we have a different
                                              ; one than the last one used in the
                                              ; pattern.
                                              IF (_npk.ins <> _npk.lst) OR (_is_DRM(_stringify(_npk.str)))
                                __inst      QSET    _npk.ins
                                              ELSE
                                __inst      QSET    0
                                              ENDI

                                              _RenderEvent(_stringify(_npk.str), __inst, _npk.vol, (_npk.len - 1))

                                            ; Keep track of the last instrument
                                            ; used in this pattern.
                                _npk.lst    QSET    _npk.ins
                                            ENDI

                                _npk.ins    QSET    _i
                                _npk.vol    QSET    _v
                                _npk.len    QSET    0
                                _npk.str    QSET    0                           ; \_ Reset array symbol ...
                                _npk.str    QSET    %n%                         ; /

                                          ENDI

                                            ; Keep track of the new length
                                _npk.len    QSET    (_npk.len + _l)

                                        ENDI

                                      ENDI

                                    LISTING "prev"
                                ENDM

                                ;; ======================================================================== ;;
                                ;;  _RenderEvent(n, i, v, l)                                                ;;
                                ;;  Private macro used by NPK.Note() to render an event into the output     ;;
                                ;;  stream.                                                                 ;;
                                ;;                                                                          ;;
                                ;;  ARGUMENTS                                                               ;;
                                ;;      n           The note event string, as received by NPK.Note().       ;;
                                ;;      i           The instrument value.                                   ;;
                                ;;      v           The volume level.                                       ;;
                                ;;      l           The length, in rows (zero-based).                       ;;
                                ;; ======================================================================== ;;
                                MACRO   _RenderEvent(n, i, v, l)
                                ;
                                        IF _is_DRM(%n%)
                                            _InsertDrum(%n%, %i%, %v%, %l%)
                                        ELSE
                                            IF _is_NUL(%n%)
                                                _InsertNull(%n%, %i%, %v%, %l%)
                                            ELSE
                                                _InsertNote(%n%, %i%, %v%, %l%)
                                            ENDI
                                        ENDI
                                ENDM

                                ;; ======================================================================== ;;
                                ;;  _InsertDrum(n, i, v, l)                                                 ;;
                                ;;  Private macro used by NPK.Note() to render a drum event to the output   ;;
                                ;;  stream.                                                                 ;;
                                ;;                                                                          ;;
                                ;;  ARGUMENTS                                                               ;;
                                ;;      n           Ignored.  (Kept for interface consistency.)             ;;
                                ;;      i           The drum instrument value.                              ;;
                                ;;      v           The volume level.                                       ;;
                                ;;      l           The length, in rows (zero-based).                       ;;
                                ;; ======================================================================== ;;
                                MACRO   _InsertDrum(n, i, v, l)
                                            DECLE   ((84 + %i%) SHL 8) + (%l% SHL 4) + (15 - %v%)
                                ENDM

                                ;; ======================================================================== ;;
                                ;;  _InsertNull(n, i, v, l)                                                 ;;
                                ;;  Private macro used by NPK.Note() to render a drum event to the output   ;;
                                ;;  stream.                                                                 ;;
                                ;;                                                                          ;;
                                ;;  ARGUMENTS                                                               ;;
                                ;;      n           Ignored.  (Kept for interface consistency.)             ;;
                                ;;      i           The drum instrument value.                              ;;
                                ;;      v           The volume level.                                       ;;
                                ;;      l           The length, in rows (zero-based).                       ;;
                                ;; ======================================================================== ;;
                                MACRO   _InsertNull(n, i, v, l)
                                ;
                                        IF (%i% <> 0)
                                            DECLE   $8000 + (%l% * $10) + (15 - %v%)
                                            DECLE   ((%i% - 1) * 3)
                                        ELSE
                                            DECLE   ((%l% * $10) + (15 - %v%))
                                        ENDI
                                ENDM

                                ;; ======================================================================== ;;
                                ;;  _InsertNote(n, i, v, l)                                                 ;;
                                ;;  Private macro used by NPK.Note() to render a drum event to the output   ;;
                                ;;  stream.                                                                 ;;
                                ;;                                                                          ;;
                                ;;  ARGUMENTS                                                               ;;
                                ;;      n           The note event string, as received by NPK.Note().       ;;
                                ;;      i           The note instrument value.                              ;;
                                ;;      v           The volume level.                                       ;;
                                ;;      l           The length, in rows (zero-based).                       ;;
                                ;; ======================================================================== ;;
                                MACRO _InsertNote(n, i, v, l)
                                        ; Note
                                        ;     - Character in ASCII Code
                                        ;     - Range: 0..7 :: ASC('A')..ASC('G')
                                        ; ----------------------------------------
                                _n0         QSET   ASC(%n%, 0)

                                        IF (_n0 < 65) OR (_n0 > 71)
                                            ERR "Invalid note"
                                        ENDI

                                        ; Conversion letter -> value
                                        ;
                                        ;       ABCDEFG -> JLACEFH
                                        ;
                                        ;   Translates a note letter to a semi-tone
                                        ;   in the range of 0x01..0x0C (12 per
                                        ;   octave) corresponding to the notes
                                        ;   starting at "C".
                                        ;
                                        ;     A (65) = 0  ->  J (74) = (9 + 1) = A
                                        ;     B (66) = 1  ->  L (76) = (B + 1) = C
                                        ;     C (67) = 2  ->  A (65) = (0 + 1) = 1
                                        ;     D (68) = 3  ->  C (67) = (2 + 1) = 3
                                        ;     E (69) = 4  ->  E (69) = (4 + 1) = 5
                                        ;     F (70) = 5  ->  F (70) = (5 + 1) = 6
                                        ;     G (71) = 6  ->  H (72) = (7 + 1) = 8
                                        ;
                                        ;       1   3   5   6   8   A   C
                                        ;       : 2 : 4 :   : 7 : 9 : B :
                                        ;     ._:_:_:_:_:___:_:_:_:_:_:_:_,
                                        ;     |  ### ###  |  ### ### ###  |
                                        ;     |  ### ###  |  ### ### ###  |
                                        ;     |  ### ###  |  ### ### ###  |
                                        ;     |  ### ###  |  ### ### ###  |
                                        ;     |  ### ###  |  ### ### ###  |
                                        ;     |   |   |   |   |   |   |   |
                                        ;     | C | D | E | F | G | A | B |
                                        ;     |___|___|___|___|___|___|___|
                                        ;       0 : 1 : 2   3 : 4 : 5 : 6
                                        ;         C#  D#      F#  G#  A#
                                        ;
                                        ;   Semi-tones:
                                        ;       C   ->  1
                                        ;       C#  ->  2
                                        ;       D   ->  3
                                        ;       D#  ->  4
                                        ;       E   ->  5
                                        ;       F   ->  6
                                        ;       F#  ->  7
                                        ;       G   ->  8
                                        ;       G#  ->  9
                                        ;       A   ->  A
                                        ;       A#  ->  B
                                        ;       B   ->  C
                                        ;
                                        ; ----------------------------------------
                                _n1         QSET   ASC("JLACEFH", (_n0 - 65)) - 64

                                        ; Sharp ?
                                        ;     - Sharp notes are the base note increased by one semi-tone.
                                        IF (ASC(%n%, 1) = 35)
                                _n1         QSET    (_n1 + 1)
                                        ELSE
                                            ; Minus ?
                                            IF (ASC(%n%, 1) <> 45)
                                                ERR "Invalid note"
                                            ENDI
                                        ENDI

                                        ; octave
                                        ;     - Numeric digit in ASCII Code
                                        ;     - Range: 0..6 :: ASC('0')..ASC('6')
                                        ;     - Octave = _o - ASC('0')
                                        ;              = (_o - 49)
                                _o            QSET    ASC(%n%, 2)

                                        IF (_o < 49) OR (_o > 55)
                                            ERR "Invalid octave"
                                        ENDI

                                        ; Put data into output stream
                                        _OutputEventData(_n1, _o, %i%, %v%, %l%)
                                ENDM

                                ;; ======================================================================== ;;
                                ;;  _OutputEventData(note, oct, ins, vol, len)                              ;;
                                ;;  Private utility macro to output an event data record.                   ;;
                                ;;                                                                          ;;
                                ;;  ARGUMENTS                                                               ;;
                                ;;      note        The decoded note value.                                 ;;
                                ;;      oct         The note octave (zero-based).                           ;;
                                ;;      ins         The instrument value.                                   ;;
                                ;;      vol         The volume level.                                       ;;
                                ;;      len         The length, in rows (zero-based).                       ;;
                                ;; ======================================================================== ;;
                                MACRO _OutputEventData(note, oct, ins, vol, len)
                                        ; Value
                                        ;     DECLE 1000 0000 0000 0000
                                        ;     DECLE 0000 0000 00II III0       (I=I-1*3)
                                        ; ------------------------------
                                        IF (%ins% <> 0)
                                _flg        QSET    $8000
                                        ELSE
                                _flg        QSET    $0000
                                        ENDI

                                        ;         FEDC BA98 7654 3210
                                        ; Format: fnnn nnnn llll vvvv
                                        ;         f     = Flag (?)- 0..1
                                        ;         l     = Length  - 0..F
                                        ;         v     = Volume  - ~(0..F) (complemented)
                                        ;         note  = Note    - 0..C
                                        ;         oct   = Octave  - 1..7
                                        ; ------------------------------
                                            DECLE   _flg + (((%note% + (12 * (%oct% - 49))) * $100) + (%len% * $10) + (15 - %vol%))

                                        IF (_flg <> 0)
                                            DECLE   ((%ins% - 1) * 3)
                                        ENDI
                                ENDM

                                ;; ======================================================================== ;;
                                ;;  _Hex2Dec(var, hex)                                                      ;;
                                ;;  Converts an ASCII character representing a Hexadecimal value, into its  ;;
                                ;;  Decimal counterpart, and assigns it to a symbol.  It validates that the ;;
                                ;;  input is a valid Hexadecimal character.                                 ;;
                                ;;                                                                          ;;
                                ;;  ARGUMENTS                                                               ;;
                                ;;      var         Symbol to hold the output value.                        ;;
                                ;;      hex         Hexadecimal character to convert (0..9; A..F).          ;;
                                ;; ======================================================================== ;;
                                MACRO _Hex2Dec(var, hex)
                                ;
                                        IF ((%hex% >= 48) AND (%hex% <= 57))
                                %var%       QSET    (%hex% - 48)
                                        ELSE
                                          IF ((%hex% >= 65) AND (%hex% <= 70))
                                %var%       QSET    (%hex% - 55)
                                          ELSE
                                            ERR "Invalid Hexadecimal digit '%hex%'."
                                          ENDI
                                        ENDI
                                ENDM

                                ;; ======================================================================== ;;
                                ;;  _Chr2Dec(var, chr)                                                      ;;
                                ;;  Converts an ASCII character representing a digit or a letter, into its  ;;
                                ;;  Decimal ordinal value, and assigns it to a symbol.  It validates that   ;;
                                ;;  the input is a valid digit or letter character.                         ;;
                                ;;                                                                          ;;
                                ;;  ARGUMENTS                                                               ;;
                                ;;      var         Symbol to hold the output value.                        ;;
                                ;;      chr         A digit or letter character to convert (0..9; A..Z).    ;;
                                ;; ======================================================================== ;;
                                MACRO _Chr2Dec(var, chr)
                                ;
                                        IF ((%chr% >= 48) AND (%chr% <= 57))
                                %var%       QSET    %chr% - 48
                                        ELSE
                                          IF ((%chr% >= 65) AND (%chr% <= 90))
                                %var%       QSET    %chr% - 55
                                          ELSE
                                            ERR "Invalid charater value '%chr%'.  Must be a digit (0..9) or a letter (A..Z)."
                                          ENDI
                                        ENDI
                                ENDM

                                ;; ======================================================================== ;;
                                ;;  _reset_event                                                            ;;
                                ;;  Private macro used by NPK.Note() to reset the state for a new note      ;;
                                ;;  event.                                                                  ;;
                                ;;                                                                          ;;
                                ;;  ARGUMENTS                                                               ;;
                                ;;      None.                                                               ;;
                                ;; ======================================================================== ;;
                                MACRO   _reset_event
                                ;
                                _npk.lst    QSET    0
                                _npk.ins    QSET    0
                                _npk.vol    QSET    0
                                _npk.len    QSET    0
                                _npk.str    QSET    0
                                ENDM

                                ;; ======================================================================== ;;
                                ;;  _stringify(sym)                                                         ;;
                                ;;  Private utility macro to convert an array symbol back into a literal    ;;
                                ;;  string.                                                                 ;;
                                ;;                                                                          ;;
                                ;;  ARGUMENTS                                                               ;;
                                ;;      sym         The name of the array symbol.                           ;;
                                ;; ======================================================================== ;;
                                MACRO   _stringify(sym)
                                    $(%sym%[0, %sym%])
                                ENDM

                                ;; ======================================================================== ;;
                                ;;  _is_NUL(n)                                                              ;;
                                ;;  Private macro used by NPK.Note() to check whether a note event string   ;;
                                ;;  represents a Null Event (NUL).                                          ;;
                                ;;                                                                          ;;
                                ;;  ARGUMENTS                                                               ;;
                                ;;      n           The note event string, as received by NPK.Note().       ;;
                                ;; ======================================================================== ;;
                                MACRO   _is_NUL(n)
                                    ((ASC(%n%, 0) = 78) AND (ASC(%n%, 1) = 85) AND (ASC(%n%, 2) = 76))
                                ENDM

                                ;; ======================================================================== ;;
                                ;;  _is_DRM(n)                                                              ;;
                                ;;  Private macro used by NPK.Note() to check whether a note event string   ;;
                                ;;  represents a Drum Event (DRM).                                          ;;
                                ;;                                                                          ;;
                                ;;  ARGUMENTS                                                               ;;
                                ;;      n           The note event string, as received by NPK.Note().       ;;
                                ;; ======================================================================== ;;
                                MACRO   _is_DRM(n)
                                    ((ASC(%n%, 0) = 68) AND (ASC(%n%, 1) = 82) AND (ASC(%n%, 2) = 77))
                                ENDM

                                ;; ======================================================================== ;;
                                ;;  _is_new_event(n)                                                        ;;
                                ;;  Private macro used by NPK.Note() to check whether a note event string   ;;
                                ;;  represents a new event.  This is the converse of _is_NUL().             ;;
                                ;;                                                                          ;;
                                ;;  ARGUMENTS                                                               ;;
                                ;;      n           The note event string, as received by NPK.Note().       ;;
                                ;; ======================================================================== ;;
                                MACRO   _is_new_event(n)
                                    (NOT _is_NUL(%n%))
                                ENDM

                                ;; ======================================================================== ;;
                                ;;  _is_change_event(n)                                                     ;;
                                ;;  Private macro used by NPK.Note() to check whether a note event string   ;;
                                ;;  represents an instrument or volume change on the current note event.    ;;
                                ;;                                                                          ;;
                                ;;  ARGUMENTS                                                               ;;
                                ;;      None.                                                               ;;
                                ;; ======================================================================== ;;
                                MACRO   _is_change_event(i, v)
                                    (((%i% <> 0) AND (%i% <> _npk.ins)) OR (%v% <> _npk.vol))
                                ENDM

                                ;; ======================================================================== ;;
                                ;;  End of File:  tracker.mac                                               ;;
                                ;; ======================================================================== ;;
                                	;[47] 	ASM INCLUDE "lib/bas-callapi.asm"
                                	SRCFILE "lib/bas-interface.bas",47
                                 INCLUDE "lib/bas-callapi.asm"
                                ; =========================================================================
                                ; Intellivision Music Tracker - IntyBASIC Procedure Call API
                                ; =========================================================================

                                ;; ======================================================================== ;;
                                ;;  SET_ACTIVE_CHANNELS                                                     ;;
                                ;;  Sets the global channel state to a special code representing the number ;;
                                ;;  of active channels available to the tracker.                            ;;
                                ;;                                                                          ;;
                                ;;  Supported values are 1 through 6.  Any other value will be ignored.     ;;
                                ;;                                                                          ;;
                                ;;  The availability of each channel depends on its priority, according to  ;;
                                ;;  the chart below:                                                        ;;
                                ;;                        +-----------+-----------+                         ;;
                                ;;                        |    MAIN   |    ECS    |       +-----------+     ;;
                                ;;                        |   PSG #1  |   PSG #2  |       |  Channel  |     ;;
                                ;;          +-------------+---+---+---+---+---+---+       |  Priority |     ;;
                                ;;          |    count    | A | B | C | D | E | F |       +-----+-----+     ;;
                                ;;          +-------------+---+---+---+---+---+---+       |  A  |  1  |     ;;
                                ;;          |      1      | X | - | - | - | - | - |       +-----+-----+     ;;
                                ;;          +-------------+---+---+---+---+---+---+       |  B  |  2  |     ;;
                                ;;          |      2      | X | X | - | - | - | - |       +-----+-----+     ;;
                                ;;          +-------------+---+---+---+---+---+---+       |  C  |  6  |     ;;
                                ;;          |      3      | X | X | - | X | - | - |       +-----+-----+     ;;
                                ;;          +-------------+---+---+---+---+---+---+       |  D  |  3  |     ;;
                                ;;          |      4      | X | X | - | X | X | - |       +-----+-----+     ;;
                                ;;          +-------------+---+---+---+---+---+---+       |  E  |  4  |     ;;
                                ;;          |      5      | X | X | - | X | X | X |       +-----+-----+     ;;
                                ;;          +-------------+---+---+---+---+---+---+       |  F  |  5  |     ;;
                                ;;          |      6      | X | X | X | X | X | X |       +-----+-----+     ;;
                                ;;          +-------------+---+---+---+---+---+---+                         ;;
                                ;;                                                                          ;;
                                ;;      LEGEND:                                                             ;;
                                ;;          [ - ] Unused                                                    ;;
                                ;;          [ X ] Active                                                    ;;
                                ;;                                                                          ;;
                                ;; ------------------------------------------------------------------------ ;;
                                ;;  NOTE:   The only reason we need this procedure is because the tracker   ;;
                                ;;          variables are not available to the program until after the      ;;
                                ;;          "IntyBASIC Interface" module is included, which doesn't happen  ;;
                                ;;          until the end of the end.                                       ;;
                                ;;                                                                          ;;
                                ;;          Since the interface module includes all dependencies, moving it ;;
                                ;;          to the top of the program would cause other problems.           ;;
                                ;;                                                                          ;;
                                ;;          An alternative would be to split the dependencies into two      ;;
                                ;;          separate modules, including all variable definitions at the top ;;
                                ;;          and all procedure code at the bottom; but that would make the   ;;
                                ;;          integration a bit more cumbersome, and put additional burdens   ;;
                                ;;          on the programmer.                                              ;;
                                ;;                                                                          ;;
                                ;;          Because we want the interface and integration to be as simple   ;;
                                ;;          as possible, with as little friction as is practical, we chose  ;;
                                ;;          to implement it this way.                                       ;;
                                ;; ------------------------------------------------------------------------ ;;
                                ;;                                                                          ;;
                                ;;  INPUTS                                                                  ;;
                                ;;      R0      The number of active channels to use (1..6).                ;;
                                ;;                                                                          ;;
                                ;;  OUTPUT                                                                  ;;
                                ;;      R0      The computed active channels code.                          ;;
                                ;;      R1      Trashed.                                                    ;;
                                ;; ======================================================================== ;;
0x5284                          SET_ACTIVE_CHANNELS  PROC
5284   0378 0001                                CMPI    #1,     R0                          ; \
5286   0205 000C                                BLT     @@__skip                            ;  |_ Check range: 1 .. TRK_MAX_CHANNELS
5288   0378 0006                                CMPI    #TRK_MAX_CHANNELS,  R0              ;  |    (Skip if outside)
528A   020E 0008                                BGT     @@__skip                            ; /

528C   0338 0006                                SUBI    #TRK_MAX_CHANNELS,  R0              ; \
528E   0020                                     NEGR    R0                                  ;  |
528F   0081                                     MOVR    R0,     R1                          ;   > channel state = ((6 - R0) * 3)
5290   0048                                     SLL     R0,     1                           ;  |
5291   00C8                                     ADDR    R1,     R0                          ; /
                                ;               MVO     R0,     _b_var(CHN_STATE)
5292   0240 010C                                MVO     R0,     (array_TRK_BYTEVAR + CHN_STATE)

5294   00AF                     @@__skip:       JR      R5
                                                ENDP

                                ;; ======================================================================== ;;
                                ;;  TRKLOADSONG    Song initialization (IntyBASIC Alternative Inteface)     ;;
                                ;;      R0: Song address                                                    ;;
                                ;;      R5: Return address                                                  ;;
                                ;; ======================================================================== ;;
0x5295                          TRKLOADSONG     PROC
5295   0081                                     MOVR    R0,     R1
5296   0208                                     DECLE   $0208                               ; Cheap NOOP (skips next instruction)

                                                ; NOTE:
                                                ;   Routine falls through onto next,
                                                ;   skipping the first word.
                                                ;           ,_____,
                                                ;           |     |
                                                ;           |     |
                                                ;        ,__|     |__,
                                                ;         \         /
                                                ;           \     /
                                                ;             \,/
                                                ENDP

                                                ; INCLUDE   "lib/tracker.asm"

                                ;; ======================================================================== ;;
                                ;;  End of File:  bas-callapi.asm                                           ;;
                                ;; ======================================================================== ;;
                                	;[48] 	ASM INCLUDE "lib/tracker.asm"
                                	SRCFILE "lib/bas-interface.bas",48
                                 INCLUDE "lib/tracker.asm"
                                ;* ======================================================================== *;
                                ;*  These routines are placed into the public domain by their authors.  All *;
                                ;*  copyright rights are hereby relinquished on the routines and data in    *;
                                ;*  this file.  -- Arnauld Chevallier, 2008; James Pujals, 2017             *;
                                ;* ======================================================================== *;

                                ;; ======================================================================== ;;
                                ;; Intellivision Music Tracker (version 1.5, rev. #4)                       ;;
                                ;; ------------------------------------------------------------------------ ;;
                                ;;                                                                          ;;
                                ;;  TRKINIT       Global tracker initialization                             ;;
                                ;;  TRKSNGINIT    Song initialization                                       ;;
                                ;;  TRKSNGINIT.1  Alternate entry point                                     ;;
                                ;;  TRKPLAY       Ticks the tracker and updates the PSG                     ;;
                                ;;                                                                          ;;
                                ;;  TRKPATINIT    (internal) Pattern initialization                         ;;
                                ;;  TRKPSGINIT    (internal) PSG device initialization                      ;;
                                ;;  TRKCHUPD      (internal) Updates one channel                            ;;
                                ;;  TRKPSGUPD     (internal) Updates one PSG device                         ;;
                                ;;                                                                          ;;
                                ;; ------------------------------------------------------------------------ ;;
                                ;;  WARNING:                                                                ;;
                                ;;      The routines below have been heavily optimized for speed and size,  ;;
                                ;;      and some of those optimizations rely on assumptions about the       ;;
                                ;;      intricate layout of the code.  Any changes must therefore account   ;;
                                ;;      for these assumptions, or run the risk of breaking the library.     ;;
                                ;;                                                                          ;;
                                ;;      You are encouraged to explore the code, but you are advised to only ;;
                                ;;      make changes if you are *absolutely* sure of what you are doing.    ;;
                                ;;                                                                          ;;
                                ;;      YOU HAVE BEEN WARNED.                                               ;;
                                ;; ------------------------------------------------------------------------ ;;
                                ;;  AUTHORS & CONTRIBUTORS                                                  ;;
                                ;;      Originally created and released publicly by Arnauld Chevallier;     ;;
                                ;;      later modified by James Pujals to include new features, address     ;;
                                ;;      some bugs, and optimize for performance.                            ;;
                                ;;                                                                          ;;
                                ;;      Created By:     Arnauld Chevallier <a_chevallier AT yahoo.com>      ;;
                                ;;      Updated By:     James Pujals <dz-game AT techunlimited.net>         ;;
                                ;;      Thanks To:      Shazz & Zapac for their creative input!             ;;
                                ;; ------------------------------------------------------------------------ ;;
                                ;;  REVISION HISTORY                                                        ;;
                                ;;      07-Sep-2008 Initial Revision                                        ;;
                                ;;      10-Jun-2017 Modified by DZ-Jay to support drum instruments and      ;;
                                ;;                  second PSG from ECS module.  Also patched some bugs and ;;
                                ;;                  optimised processing for performance.                   ;;
                                ;;      12-Apr-2018 Finally fixed drums+tone bug so that you can use the A  ;;
                                ;;                  Channel for either, interchangeably.                    ;;
                                ;;      31-Jul-2020 Marked-up with comments and cleaned up the source for   ;;
                                ;;                  public release.  Also made 6-channel support optional,  ;;
                                ;;                  with an explicit conditional symbol (TRK_ENABLED_6_CHN).;;
                                ;;      09-Aug-2020 That drum fix from 2018? Didn't work. It is now fixed   ;;
                                ;;                  and fully tested, so I am absolutely sure.  Drums and   ;;
                                ;;                  tones can now be used interchangeably on channel "A"    ;;
                                ;;                  in either PSG, independently.  YAY!!!                   ;;
                                ;;      24-Aug-2020 Fixed drums to honor volume in DRUM() note declaration. ;;
                                ;;                  This allows for accents and other performance niceties. ;;
                                ;;      29-Dec-2020 Updated library to support flexible interface for ASM   ;;
                                ;;                  and IntyBASIC integration.                              ;;
                                ;;      ------------------------------------------------------------------- ;;
                                ;;      10-Jan-2021 Rev. #1                                                 ;;
                                ;;                  Happy New Year! Fixed a bug that caused proc TRKPATINIT ;;
                                ;;                  to skip 7 words per pattern instead of 4 when, when the ;;
                                ;;                  6-channel support (TRK_ENABLED_6_CHN) is disabled.      ;;
                                ;;                                                                          ;;
                                ;;                  Adjusted envelope synthesizer to support five levels    ;;
                                ;;                  (0..4), which allows single-tick advancements.          ;;
                                ;;                                                                          ;;
                                ;;      22-Jan-2021 Rev. #2                                                 ;;
                                ;;                  NPK.Note() did not treat NUL events at the top of the   ;;
                                ;;                  pattern as a new event, and therefore skipped them.     ;;
                                ;;                                                                          ;;
                                ;;                  Added new instruments to the Global Music module.       ;;
                                ;;                                                                          ;;
                                ;;                  Updated procedure TRKPATINIT to skip PSG updates        ;;
                                ;;                  completely when the end of song marker is detected.     ;;
                                ;;                  This ensures that the tracker stays silent, even if     ;;
                                ;;                  notes were still active.                                ;;
                                ;;                                                                          ;;
                                ;;                  NPK.Note() did not verify that DRM events had a valid   ;;
                                ;;                  instrument number.                                      ;;
                                ;;                                                                          ;;
                                ;;                  NPK.Note() did not compact same instrument in multiple  ;;
                                ;;                  note events.                                            ;;
                                ;;                                                                          ;;
                                ;;      03-Feb-2021 Rev. #3                                                 ;;
                                ;;                  Added "Active Channel State" to selectively enable      ;;
                                ;;                  playback channels.  This is implemented by re-arranging ;;
                                ;;                  the call order of the TRKPSGUPD "call-chain" and        ;;
                                ;;                  skipping any inactive channels, based on priority.      ;;
                                ;;                                                                          ;;
                                ;;                  Re-organized the integration interface and extracted    ;;
                                ;;                  all IntyBASIC alternative interfaces into a new module. ;;
                                ;;                                                                          ;;
                                ;;      07-Mar-2021 Rev. #4                                                 ;;
                                ;;                  Instrument envelopes now recycle indefinitely, by       ;;
                                ;;                  backtracking a number of sample points from the end.    ;;
                                ;;                  The backtracking offset is configurable with a global   ;;
                                ;;                  constant (TRK_ENV_REWIND_COUNT).                        ;;
                                ;;                                                                          ;;
                                ;;                  Optimized the code for size and speed to compensate for ;;
                                ;;                  additional code brought in by recent enhancements.      ;;
                                ;;                                                                          ;;
                                ;;                  Changed the behaviour of "NULL" events that include     ;;
                                ;;                  instrument changes, to reset the channel counter.  The  ;;
                                ;;                  old behaviour is believed to be a bug.                  ;;
                                ;; ------------------------------------------------------------------------ ;;
                                ;;                                                                          ;;
                                ;;  INPUTS for TRKINIT                                                      ;;
                                ;;      None                                                                ;;
                                ;;                                                                          ;;
                                ;;  INPUTS for TRKSNGINIT                                                   ;;
                                ;;      R5      Pointer to invocation record, followed by return address    ;;
                                ;;              Song base address               1 DECLE                     ;;
                                ;;                                                                          ;;
                                ;;  INPUTS for TRKSNGINIT.1                                                 ;;
                                ;;      R1      Song base address                                           ;;
                                ;;                                                                          ;;
                                ;;  INPUTS for TRKPLAY                                                      ;;
                                ;;      None                                                                ;;
                                ;;                                                                          ;;
                                ;;  CODESIZE                                                                ;;
                                ;;      569     words (6-channels)                                          ;;
                                ;;      543     words (3-channels)                                          ;;
                                ;;                                                                          ;;
                                ;; ======================================================================== ;;

                                ;; ======================================================================== ;;
                                ;;  TRKSNGINIT    Song initialization                                       ;;
                                ;;      R5: Input record followed by return address:                        ;;
                                ;;          Pointer to song address                                         ;;
                                ;;                                                                          ;;
                                ;;  @@1:                                                                    ;;
                                ;;      R1: Song address                                                    ;;
                                ;;      R5: Return address                                                  ;;
                                ;; ======================================================================== ;;
0x5297                          TRKSNGINIT      PROC
5297   02A9                                     MVI@    R5,     R1                          ; \_ Retrieve the song address and store it
                                ;@@1:            MVO     R1,     _w_var(SONG)                ; /
5298   0241 0308                @@1:            MVO     R1,     (array_&TRK_WORDVAR + SONG)                ; /

                                                ; Extract song header:
                                                ; ------------------------------------------
529A   02F9 0002                                ADDI    #2,     R1                          ; \_ @@instr
529C   0289                                     MVI@    R1,     R1                          ; /
                                ;               MVO     R1,     _w_var(INS_PTR)             ;     Retrieve instrument record address and store it
529D   0241 0309                                MVO     R1,     (array_&TRK_WORDVAR + INS_PTR)             ;     Retrieve instrument record address and store it

529F   02B9 0022                                MVII    #TRK_BYTEVAR.SIZE,      R1          ; Clear all 8-bit variables
52A1   02BC 0002                                MVII    #TRK_BYTEVAR.START,     R4
52A3   01C0                                     CLRR    R0
52A4   0260                     @@__loop:       MVO@    R0,     R4
52A5   0011                                     DECR    R1
52A6   022C 0003                                BNZE    @@__loop

52A8   02B8 0000                                MVII    #TRK_GLOBAL_FADER,  R0
                                ;               MVO     R0,     _b_var(MASTER_FADER)        ; default global volume fading
52AA   0240 010D                                MVO     R0,     (array_TRK_BYTEVAR + MASTER_FADER)        ; default global volume fading

                                                ; NOTE:
                                                ;   Routine falls through onto next, so
                                                ;   that the first pattern is initialized
                                                ;   as part of the song initialization.
                                                ;           ,_____,
                                                ;           |     |
                                                ;           |     |
                                                ;        ,__|     |__,
                                                ;         \         /
                                                ;           \     /
                                                ;             \,/
                                            ENDP

                                ;; ======================================================================== ;;
                                ;;  TRKPATINIT    Pattern initialization                                    ;;
                                ;; ======================================================================== ;;
0x52AC                          TRKPATINIT      PROC
                                ;               MVI     _w_var(SONG),  R4
52AC   0284 0308                                MVI     (array_&TRK_WORDVAR + SONG),  R4
52AE   000C                                     INCR    R4                                  ; skip speed
52AF   02A2                                     MVI@    R4,     R2                          ; R2 = address of 1st pattern
52B0   02FC 0002                                ADDI    #2,     R4                          ; skip instruments and drums ptr
                                ;               MVI     _b_var(PAT),   R0                   ; R0 = position in patterns order table
52B2   0280 0111                                MVI     (array_TRK_BYTEVAR + PAT),   R0                   ; R0 = position in patterns order table
52B4   00C4                                     ADDR    R0,     R4

                                                ; ------------------------------------------
                                                ; Check if we found the end of the song.
                                                ; ------------------------------------------
52B5   02A1                                     MVI@    R4,     R1                          ; R1 = pattern number
52B6   0089                                     TSTR    R1
52B7   0203 0008                                BPL     @@pat_ok                            ; end of patterns ? ...

52B9   0379 F000                                CMPI    #TRK_END_SONG, R1                   ; ... yes : stop replay ?
52BB   0204 0020                                BEQ     @@end_song

52BD   00C8                     @@rewind:       ADDR    R1,     R0                          ; ... no : jump to loop position ...
52BE   00CC                                     ADDR    R1,     R4
52BF   0014                                     DECR    R4
52C0   02A1                                     MVI@    R4,     R1                          ; ... and read again

52C1   0008                     @@pat_ok:       INCR    R0                                  ; increment position
                                ;               MVO     R0,     _b_var(PAT)                 ; in patterns order table
52C2   0240 0111                                MVO     R0,     (array_TRK_BYTEVAR + PAT)                 ; in patterns order table

                                            IF (TRK_ENABLED_6_CHN)
52C4   0088                                     MOVR    R1,     R0                          ; Skip to next record: 7x words ahead from @@patterns
52C5   004D                                     SLL     R1,     2                           ; R4 = ((R1 * 8) - R1) + R2 (address of 1st pattern)
52C6   0049                                     SLL     R1,     1
52C7   0101                                     SUBR    R0,     R1
                                            ELSE                                            ; Skip to next record: 4x words ahead from @@patterns
                                                SLL     R1,     2                           ; R4 = (R1 * 4) + R2 (address of 1st pattern)
                                            ENDI

52C8   008C                                     MOVR    R1,     R4                          ; (beginning of pattern's details)
52C9   00D4                                     ADDR    R2,     R4

52CA   02A0                                     MVI@    R4,     R0                          ; save pattern counter (length, first DECLE in @@patterns)
                                ;               MVO     R0,     _b_var(COUNT_P)
52CB   0240 0110                                MVO     R0,     (array_TRK_BYTEVAR + COUNT_P)

52CD   00AA                                     MOVR    R5,     R2                          ; Save the return address

                                ;               MVII    #_w_var(POS_A), R5                  ; Get base address of channel pattern position records
52CE   02BD 030A                                MVII    #(array_&TRK_WORDVAR + POS_A), R5                  ; Get base address of channel pattern position records

                                            REPEAT (TRK_MAX_CHANNELS)                       ; Update channel pattern positions
52D0   02A0                                     MVI@    R4,     R0
52D1   0268                                     MVO@    R0,     R5
  ;== 1                                     ENDR
52D2   02A0                                     MVI@    R4,     R0
52D3   0268                                     MVO@    R0,     R5
  ;== 2                                     ENDR
52D4   02A0                                     MVI@    R4,     R0
52D5   0268                                     MVO@    R0,     R5
  ;== 3                                     ENDR
52D6   02A0                                     MVI@    R4,     R0
52D7   0268                                     MVO@    R0,     R5
  ;== 4                                     ENDR
52D8   02A0                                     MVI@    R4,     R0
52D9   0268                                     MVO@    R0,     R5
  ;== 5                                     ENDR
52DA   02A0                                     MVI@    R4,     R0
52DB   0268                                     MVO@    R0,     R5
  ;== 6                                     ENDR

52DC   0097                                     JR      R2                                  ; Return

                                                ; NEAT HACK:
                                                ;   Change the return address to bypass
                                                ;   PSG updates in TRKPLAY().
                                                ; ------------------------------------------
52DD   02BA 5347                @@end_song:     MVII    #TRKPLAY.done,  R2                  ; Change the return address ...
52DF   0208                                     DECLE   $0208                               ;   ... Skip next instruction (NOPP)

                                                ; NOTE:
                                                ;   Routine falls through onto next, so
                                                ;   that we initialize the PSG devices
                                                ;   on our way out the door.
                                                ;           ,_____,
                                                ;           |     |
                                                ;           |     |
                                                ;        ,__|     |__,
                                                ;         \         /
                                                ;           \     /
                                                ;             \,/
                                                ENDP

                                ;; ======================================================================== ;;
                                ;;  TRKINIT       Global tracker initialization                             ;;
                                ;; ======================================================================== ;;
0x52E0                          TRKINIT         PROC
52E0   00AA                                     MOVR    R5,     R2

52E1   01C0                                     CLRR    R0
                                ;               MVO     R0,     _b_var(CHN_STATE)           ; Reset active-channel state (all active)
52E2   0240 010C                                MVO     R0,     (array_TRK_BYTEVAR + CHN_STATE)           ; Reset active-channel state (all active)
                                ;               MVO     R0,     _w_var(SONG)                ; Clear song pointer
52E4   0240 0308                                MVO     R0,     (array_&TRK_WORDVAR + SONG)                ; Clear song pointer
                                ;               MVO     R0,     _b_var(MASTER_FADER)        ; Reset global volume fader
52E6   0240 010D                                MVO     R0,     (array_TRK_BYTEVAR + MASTER_FADER)        ; Reset global volume fader

52E8   02BD 52FD                                MVII    #TRKPSGINIT.call_chain, R5          ; Engage call-chain (just fall through)

                                                ; NOTE:
                                                ;   Routine falls through onto next, so
                                                ;   that we reset each PSG device
                                                ;   individually, as part of tracker
                                                ;   global initialization.
                                                ;           ,_____,
                                                ;           |     |
                                                ;           |     |
                                                ;        ,__|     |__,
                                                ;         \         /
                                                ;           \     /
                                                ;             \,/
                                            ENDP

                                ;; ======================================================================== ;;
                                ;;  TRKPSGINIT      PSG initialization                                      ;;
                                ;;      R2: Return address                                                  ;;
                                ;;      R5: Input record:                                                   ;;
                                ;;          Pointer to PSG address                                          ;;
                                ;; ======================================================================== ;;
0x52EA                          TRKPSGINIT      PROC
52EA   02AC                                     MVI@    R5,     R4                          ; Get PSG base address argument ($xF0)

52EB   01C0                                     CLRR    R0
                                                                                            ; Clear all channel periods / low, use auto increm
52EC   0260                                     MVO@    R0,     R4                          ;   @@chn_a_lo ($xF0 ch A)
52ED   0260                                     MVO@    R0,     R4                          ;   @@chn_b_lo ($xF1 ch B)
52EE   0260                                     MVO@    R0,     R4                          ;   @@chn_c_lo ($xF2 ch C)

52EF   000C                                     INCR    R4                                  ; Skip @@envlp_lo
                                                                                            ; Clear all channel periods / hi
52F0   0260                                     MVO@    R0,     R4                          ;   @@chn_a_hi ($xF4 ch A)
52F1   0260                                     MVO@    R0,     R4                          ;   @@chn_b_hi ($xF5 ch B)
52F2   0260                                     MVO@    R0,     R4                          ;   @@chn_c_hi ($xF6 ch C)

52F3   000C                                     INCR    R4                                  ; Skip @@envlp_hi
52F4   02B9 0038                                MVII    #$38,   R1                          ; Enable I/O port, enable tone, disable noise
52F6   0261                                     MVO@    R1,     R4                          ;   @@chan_enable ($xF8)

52F7   02FC 0002                                ADDI    #2,     R4                          ; Skip to @@chn_a_vol
                                                                                            ; Clear all channel volumes
52F9   0260                                     MVO@    R0,     R4                          ;   @@chn_a_vol ($xFB ch A)
52FA   0260                                     MVO@    R0,     R4                          ;   @@chn_b_vol ($xFC ch B)
52FB   0260                                     MVO@    R0,     R4                          ;   @@chn_c_vol ($xFD ch C)

52FC   02AF                                     MVI@    R5,     PC                          ; Jump to next procedure in chain

0x52FD                          @@call_chain:   ; -----------------------------------------
                                                ; Call-chain to initialize PSG devices
                                                ; -----------------------------------------
52FD   01F0                                     DECLE   PSG0                                ; Initialize PSG #0

                                        IF (TRK_ENABLED_6_CHN)
52FE   52EA                                     DECLE   TRKPSGINIT
52FF   00F0                                     DECLE   PSG1                                ; Initialize PSG #1
                                        ENDI

5300   5301                                     DECLE   ($ + 1)                             ; End call-chain

5301   0097                     @@return:       JR      R2                                  ; Return to caller
                                                ENDP

                                ;; ======================================================================== ;;
                                ;;  TRKPLAY       Ticks the tracker and updates the PSG                     ;;
                                ;; ======================================================================== ;;
0x5302                          TRKPLAY         PROC
5302   0275                                     BEGIN

                                ;               MVI     _w_var(SONG),     R1                ; R1 = song base address
5303   0281 0308                                MVI     (array_&TRK_WORDVAR + SONG),     R1                ; R1 = song base address
5305   0089                                     TSTR    R1                                  ; is a song actually playing ?
5306   0204 003F                                BEQ     @@done

                                ;               MVI     _b_var(COUNT_M),  R0                ; ... yes : increment global music counter
5308   0280 010F                                MVI     (array_TRK_BYTEVAR + COUNT_M),  R0                ; ... yes : increment global music counter
530A   0008                                     INCR    R0
                                ;               MVO     R0,     _b_var(COUNT_M)
530B   0240 010F                                MVO     R0,     (array_TRK_BYTEVAR + COUNT_M)

                                ;               MVI     _b_var(REF_M),    R0                ; refresh notes ?
530D   0280 010E                                MVI     (array_TRK_BYTEVAR + REF_M),    R0                ; refresh notes ?
530F   0010                                     DECR    R0
                                ;               MVO     R0,     _b_var(REF_M)
5310   0240 010E                                MVO     R0,     (array_TRK_BYTEVAR + REF_M)
5312   0203 001B                                BPL     @@upd_psg                           ; ... no : update PSG

5314   0288                                     MVI@    R1,     R0                          ; ... yes : read speed
                                ;               MVO     R0,     _b_var(REF_M)
5315   0240 010E                                MVO     R0,     (array_TRK_BYTEVAR + REF_M)

                                                ; -----------------------------------------
                                                ; The call-chain below avoids having to
                                                ; CALL-then-RETURN from a procedure, only
                                                ; to CALL another one.  We save about 2/3
                                                ; of the cycle cost from calling normally.
                                                ; -----------------------------------------
5317   0004 0150 0348           @@upd_chn:      CALL    TRKCHUPD                            ; Engage call-chain
                                ;               DECLE   _b_var(REF_A)
531A   0118                                     DECLE   (array_TRK_BYTEVAR + REF_A)

531B   5348                                     DECLE   TRKCHUPD
                                ;               DECLE   _b_var(REF_B)
531C   0119                                     DECLE   (array_TRK_BYTEVAR + REF_B)

531D   5348                                     DECLE   TRKCHUPD
                                ;               DECLE   _b_var(REF_C)
531E   011A                                     DECLE   (array_TRK_BYTEVAR + REF_C)

                                        IF (TRK_ENABLED_6_CHN)
531F   5348                                     DECLE   TRKCHUPD
                                ;               DECLE   _b_var(REF_D)
5320   011B                                     DECLE   (array_TRK_BYTEVAR + REF_D)

5321   5348                                     DECLE   TRKCHUPD
                                ;               DECLE   _b_var(REF_E)
5322   011C                                     DECLE   (array_TRK_BYTEVAR + REF_E)

5323   5348                                     DECLE   TRKCHUPD
                                ;               DECLE   _b_var(REF_F)
5324   011D                                     DECLE   (array_TRK_BYTEVAR + REF_F)
                                        ENDI

5325   5326                                     DECLE   ($ + 1)                             ; End call-chain

5326   02BD 532F                                MVII    #@@upd_psg,         R5              ; Set return address to avoid an expensive
                                                                                            ;   CALL after BNZE test.

                                ;               MVI     _b_var(COUNT_P),    R0              ; \
5328   0280 0110                                MVI     (array_TRK_BYTEVAR + COUNT_P),    R0              ; \
532A   0010                                     DECR    R0                                  ;  > Decrement pattern counter (--COUNT_P)
                                ;               MVO     R0,     _b_var(COUNT_P)             ; /
532B   0240 0110                                MVO     R0,     (array_TRK_BYTEVAR + COUNT_P)             ; /
532D   0224 0082                                BZE     TRKPATINIT                          ; If zero, get and initialize new pattern.
                                                                                            ;   (Branch directly is cheaper than BNZE + CALL.)
                                                ; -----------------------------------------
                                                ; The call-chain below avoids having to
                                                ; CALL-then-RETURN from a procedure, only
                                                ; to CALL another one.  We save about 2/3
                                                ; of the cycle cost from calling normally.
                                                ; -----------------------------------------
532F   02BD 5334                @@upd_psg:      MVII    #@@__psg_tbl,       R5              ; \_ Compute call-chain starting point
                                ;               ADD     _b_var(CHN_STATE),  R5              ; /
5331   02C5 010C                                ADD     (array_TRK_BYTEVAR + CHN_STATE),  R5              ; /
5333   02AF                                     MVI@    R5,     PC                          ; Engage call-chain

5334   5374                     @@__psg_tbl:    DECLE   TRKPSGUPD                           ; Channel #6: offset 0
                                ;               DECLE   _b_var(NOTE_C)
5335   0114                                     DECLE   (array_TRK_BYTEVAR + NOTE_C)
5336   01F2                                     DECLE   PSG0.chn_c_lo

                                        IF (TRK_ENABLED_6_CHN)
5337   5374                                     DECLE   TRKPSGUPD                           ; Channel #5: offset 3
                                ;               DECLE   _b_var(NOTE_F)
5338   0117                                     DECLE   (array_TRK_BYTEVAR + NOTE_F)
5339   00F2                                     DECLE   PSG1.chn_c_lo

533A   5374                                     DECLE   TRKPSGUPD                           ; Channel #4: offset 6
                                ;               DECLE   _b_var(NOTE_E)
533B   0116                                     DECLE   (array_TRK_BYTEVAR + NOTE_E)
533C   00F1                                     DECLE   PSG1.chn_b_lo

533D   5374                                     DECLE   TRKPSGUPD                           ; Channel #3: offset 9
                                ;               DECLE   _b_var(NOTE_D)
533E   0115                                     DECLE   (array_TRK_BYTEVAR + NOTE_D)
533F   00F0                                     DECLE   PSG1.chn_a_lo
                                        ENDI

5340   5374                                     DECLE   TRKPSGUPD                           ; Channel #2: offset 12
                                ;               DECLE   _b_var(NOTE_B)
5341   0113                                     DECLE   (array_TRK_BYTEVAR + NOTE_B)
5342   01F1                                     DECLE   PSG0.chn_b_lo

5343   5374                                     DECLE   TRKPSGUPD                           ; Channel #1: offset 15
                                ;               DECLE   _b_var(NOTE_A)
5344   0112                                     DECLE   (array_TRK_BYTEVAR + NOTE_A)
5345   01F0                                     DECLE   PSG0.chn_a_lo

5346   5347                                     DECLE   ($ + 1)                             ; End call-chain

5347   02B7                     @@done:         RETURN
                                                ENDP

                                ;; ======================================================================== ;;
                                ;;  TRKCHUPD      Updates a channel                                         ;;
                                ;;      R5: Input record followed by return address:                        ;;
                                ;;          Pointer to channel x refresh counter (REF_x)                    ;;
                                ;; ======================================================================== ;;
0x5348                          TRKCHUPD        PROC
5348   02AB                                     MVI@    R5,     R3                          ; Get channel argument

5349   0298                                     MVI@    R3,     R0                          ; (R3 = REF_x)
534A   0338 0010                                SUBI    #$10,   R0                          ; Decrement counter (it's shifted left 4-bits: counter -= 16)
534C   0203 0024                                BPL     @@ch_updt                           ;   >= 0: Update channel counter and exit
                                                                                            ;   <  0: Reset channel

                                ;@@ch_new:       ADDI    #_bw_vardlt(REF_A, POS_A),  R3      ; (R3 = POS_x)
                                ;@@ch_new:       ADDI    #((_w_var(POS_A) - _b_var(REF_A)) AND $FFFF),  R3      ; (R3 = POS_x)
                                ;@@ch_new:       ADDI    #(((array_&TRK_WORDVAR + POS_A) - _b_var(REF_A)) AND $FFFF),  R3      ; (R3 = POS_x)
534E   02FB 01F2                @@ch_new:       ADDI    #(((array_&TRK_WORDVAR + POS_A) - (array_TRK_BYTEVAR + REF_A)) AND $FFFF),  R3      ; (R3 = POS_x)
5350   029C                                     MVI@    R3,     R4                          ; Get pointer to sub-pattern to play
5351   02A0                                     MVI@    R4,     R0                          ; Get content of sub-pattern (row event)

5352   0081                                     MOVR    R0,     R1                          ; See if the event includes a change in instrument:
5353   0203 0006                                BPL     @@data_ok                           ;   >= 0: No instrument change, continue
                                                                                            ;   <  0: Instrument change, read additional record

5355   02A2                                     MVI@    R4,     R2                          ; Get instrument data
                                ;               ADDI    #_wb_vardlt(POS_A, INSTR_A),R3      ;   (R3 = INSTR_x)
                                ;               ADDI    #((_b_var(INSTR_A) - _w_var(POS_A)) AND $FFFF),R3      ;   (R3 = INSTR_x)
                                ;               ADDI    #(((array_TRK_BYTEVAR + INSTR_A) - _w_var(POS_A)) AND $FFFF),R3      ;   (R3 = INSTR_x)
5356   02FB FE1A                                ADDI    #(((array_TRK_BYTEVAR + INSTR_A) - (array_&TRK_WORDVAR + POS_A)) AND $FFFF),R3      ;   (R3 = INSTR_x)
5358   025A                                     MVO@    R2,     R3                          ; Save it
                                ;               SUBI    #_wb_vardlt(POS_A, INSTR_A),R3      ;   (R3 = POS_x)
                                ;               SUBI    #((_b_var(INSTR_A) - _w_var(POS_A)) AND $FFFF),R3      ;   (R3 = POS_x)
                                ;               SUBI    #(((array_TRK_BYTEVAR + INSTR_A) - _w_var(POS_A)) AND $FFFF),R3      ;   (R3 = POS_x)
5359   033B FE1A                                SUBI    #(((array_TRK_BYTEVAR + INSTR_A) - (array_&TRK_WORDVAR + POS_A)) AND $FFFF),R3      ;   (R3 = POS_x)

535B   025C                     @@data_ok:      MVO@    R4,     R3                          ; Update POS_x

                                ;               ADDI    #_wb_vardlt(POS_A, NOTE_A), R3      ; (R3 = NOTE_x)
                                ;               ADDI    #((_b_var(NOTE_A) - _w_var(POS_A)) AND $FFFF), R3      ; (R3 = NOTE_x)
                                ;               ADDI    #(((array_TRK_BYTEVAR + NOTE_A) - _w_var(POS_A)) AND $FFFF), R3      ; (R3 = NOTE_x)
535C   02FB FE08                                ADDI    #(((array_TRK_BYTEVAR + NOTE_A) - (array_&TRK_WORDVAR + POS_A)) AND $FFFF), R3      ; (R3 = NOTE_x)
535E   03B9 7F00                                ANDI    #$7F00, R1                          ; Keep only 7 bits to get only note # (i.e., note is in upper byte)
5360   0204 0002                                BZE     @@skip_sav                          ; Skip if note == 0 (i.e., "NULL" event, keep same note)

5362   0041                                     SWAP    R1                                  ; Move note in the reg lower byte
5363   0259                                     MVO@    R1,     R3                          ; Save new note

                                ;@@skip_sav:     ADDI    #_b_vardlt(NOTE_A, REF_A),  R3      ; (R3 = REF_x)
                                ;@@skip_sav:     ADDI    #((_b_var(REF_A) - _b_var(NOTE_A)) AND $FFFF),  R3      ; (R3 = REF_x)
                                ;@@skip_sav:     ADDI    #(((array_TRK_BYTEVAR + REF_A) - _b_var(NOTE_A)) AND $FFFF),  R3      ; (R3 = REF_x)
5364   02FB 0006                @@skip_sav:     ADDI    #(((array_TRK_BYTEVAR + REF_A) - (array_TRK_BYTEVAR + NOTE_A)) AND $FFFF),  R3      ; (R3 = REF_x)
5366   0258                                     MVO@    R0,     R3                          ; Save new refresh value

5367   03B8 FF0F                                ANDI    #$FF0F, R0                          ; Isolate volume: keep only last 4 bits of pattern data
                                ;               ADDI    #_b_vardlt(REF_A, VOL_A),   R3      ; (R3 = VOL_x)
                                ;               ADDI    #((_b_var(VOL_A) - _b_var(REF_A)) AND $FFFF),   R3      ; (R3 = VOL_x)
                                ;               ADDI    #(((array_TRK_BYTEVAR + VOL_A) - _b_var(REF_A)) AND $FFFF),   R3      ; (R3 = VOL_x)
5369   02FB 0006                                ADDI    #(((array_TRK_BYTEVAR + VOL_A) - (array_TRK_BYTEVAR + REF_A)) AND $FFFF),   R3      ; (R3 = VOL_x)
536B   0258                                     MVO@    R0,     R3                          ; Save new volume (lower byte only)

536C   03B8 FF00                                ANDI    #$FF00, R0                          ; If ((note == 0) && (instr == 0)) (i.e., "NULL" event)?
536E   0204 0003                                BZE     @@ch_ok                             ;   Yes: Skip counter reset (it's just a note extension)

                                                ; NOTE:
                                                ;   The note or the instrument changed, so
                                                ;   we reset the channel counter.
                                                ;
                                                ;   Because the above ANDI instruction
                                                ;   cleared the lower byte, we can just use
                                                ;   it to store a zero in 8-bit variable
                                                ;   "COUNT_x," saving the cost of CLRR.
                                                ;   (Neat, uh?)
                                                ; -----------------------------------------
                                ;               ADDI    #_b_vardlt(VOL_A, COUNT_A), R3      ; (R3 = COUNT_x)
                                ;               ADDI    #((_b_var(COUNT_A) - _b_var(VOL_A)) AND $FFFF), R3      ; (R3 = COUNT_x)
                                ;               ADDI    #(((array_TRK_BYTEVAR + COUNT_A) - _b_var(VOL_A)) AND $FFFF), R3      ; (R3 = COUNT_x)
5370   02FB 000C                                ADDI    #(((array_TRK_BYTEVAR + COUNT_A) - (array_TRK_BYTEVAR + VOL_A)) AND $FFFF), R3      ; (R3 = COUNT_x)
5372   0258                     @@ch_updt:      MVO@    R0,     R3

5373   02AF                     @@ch_ok:        MVI@    R5,     PC                          ; Jump to next procedure in chain
                                                ENDP

                                ;; ======================================================================== ;;
                                ;;  TRKPSGUPD     Updates the PSG                                           ;;
                                ;;      R5: Input record followed by return address:                        ;;
                                ;;          Pointer to PSG channel note (NOTE_x)                            ;;
                                ;;          Pointer to PSG channel low address (@@chn_x_lo)                 ;;
                                ;; ======================================================================== ;;
0x5374                          TRKPSGUPD       PROC
5374   02AB                                     MVI@    R5,     R3                          ; Get channel argument

5375   0299                                     MVI@    R3,     R1                          ; read note in NOTE_x

                                                ; ------------------------------------------
                                                ; NOTE:
                                                ;   Local channel counter (COUNT_x) is used
                                                ;   for instrument pitch effects, localized
                                                ;   to a note.  It counts from $00 to $FF
                                                ;   or until the end of a note.
                                                ;
                                                ;   The reason the pitch effects do not use
                                                ;   the global counter (COUNT_M) is so that
                                                ;   they can guarantee that each note starts
                                                ;   its pitch effects from the beginning of
                                                ;   each effect record (index #0).
                                                ; ------------------------------------------
                                ;               ADDI    #_b_vardlt(NOTE_A, COUNT_A),  R3    ; (R3 = COUNT_x)
                                ;               ADDI    #((_b_var(COUNT_A) - _b_var(NOTE_A)) AND $FFFF),  R3    ; (R3 = COUNT_x)
                                ;               ADDI    #(((array_TRK_BYTEVAR + COUNT_A) - _b_var(NOTE_A)) AND $FFFF),  R3    ; (R3 = COUNT_x)
5376   02FB 0018                                ADDI    #(((array_TRK_BYTEVAR + COUNT_A) - (array_TRK_BYTEVAR + NOTE_A)) AND $FFFF),  R3    ; (R3 = COUNT_x)
5378   029A                                     MVI@    R3,     R2                          ; Get counter value
5379   037A 00FF                                CMPI    #$FF,   R2                          ; \_ Limit counter at $FF without recycling
537B   0204 0003                                BEQ     @@cnt_ok                            ; /

537D   000A                                     INCR    R2                                  ; \
537E   025A                                     MVO@    R2,     R3                          ;  > Increment counter and store it, but keep
537F   0012                                     DECR    R2                                  ; /     the pre-increment value for effects.

5380   0379 0054                @@cnt_ok:       CMPI    #@@nt_cnt, R1                       ; Is this a drum event?
5382   020E 0072                                BGT     @@drum                              ;   Yes: Jump to drums synthesizer

                                ;; ------------------------------------------------------------------------ ;;
                                ;;  Standard Instrument Synthesizer                                         ;;
                                ;; ------------------------------------------------------------------------ ;;
                                ;;      R1: NOTE_x event data (current "note" < 85)                         ;;
                                ;;      R2: COUNT_x value (pre-increment)                                   ;;
                                ;;      R3: Pointer to COUNT_x                                              ;;
                                ;;      R5: Input record followed by return address:                        ;;
                                ;;          Pointer to PSG channel frequency register (@@chn_x_lo)          ;;
                                ;;                                                                          ;;
                                ;;  Note Data Format (NOTE_x):                                              ;;
                                ;;      0nnn nnnn                                                           ;;
                                ;;                                                                          ;;
                                ;;      Legend:                                                             ;;
                                ;;          n: Note index number (1..84)                                    ;;
                                ;;                                                                          ;;
                                ;;  NOTE:   A note index ("n") of zero indicates a "Null" event, which      ;;
                                ;;          involves a volume or instrument change on the same note.        ;;
                                ;; ------------------------------------------------------------------------ ;;
                                ;               SUBI    #_b_vardlt(INSTR_A, COUNT_A),R3     ; (R3 = INSTR_x)
                                ;               SUBI    #((_b_var(COUNT_A) - _b_var(INSTR_A)) AND $FFFF),R3     ; (R3 = INSTR_x)
                                ;               SUBI    #(((array_TRK_BYTEVAR + COUNT_A) - _b_var(INSTR_A)) AND $FFFF),R3     ; (R3 = INSTR_x)
5384   033B 0006                                SUBI    #(((array_TRK_BYTEVAR + COUNT_A) - (array_TRK_BYTEVAR + INSTR_A)) AND $FFFF),R3     ; (R3 = INSTR_x)
5386   029C                                     MVI@    R3,     R4                          ; R4 = pointer to instrument
                                ;               ADD     _w_var(INS_PTR),R4
5387   02C4 0309                                ADD     (array_&TRK_WORDVAR + INS_PTR),R4

5389   0272                                     PSHR    R2                                  ; Save channel counter
538A   03BA 0003                                ANDI    #(TRK_PITCH_FX_STEPS - 1),   R2     ; \
538C   02E2                                     ADD@    R4,     R2                          ;  > Apply pitch effect (0..7):
538D   02D1                                     ADD@    R2,     R1                          ; /     note += (*instr[0] + (COUNT_x % 8))

538E   02F9 5427                                ADDI    #(@@nt - 1),    R1                  ; Read period from notes (@@nt) table
5390   0288                                     MVI@    R1,     R0                          ; R0 = note period

                                                ; Compute vibrato amplitude
                                                ;   0:  No vibrato
                                                ;   1:  1/4 amplitude (low)
                                                ;   2:  1/2 amplitude (med)
                                                ;   3:  Full amplitude (high)
5391   02A2                                     MVI@    R4,     R2                          ; R2 = type of vibrato for this channel
5392   0012                                     DECR    R2                                  ; \_ If (--vibrato < 0) ?
5393   020B 001B                                BMI     @@vibr0                             ; /     Yes, skip amplitude adjustment

5395   02F9 0054                                ADDI    #@@nt_cnt,      R1                  ; read vibrato amplitude for this note
5397   0289                                     MVI@    R1,     R1                          ; R1 = vibrato amplitude

5398   00D7                                     ADDR    R2,     PC                          ; Determine the factor by which to divide the amplitude.

5399   0061                     @@low_vibr:     SLR     R1                                  ; low vibrato --> 1/4 amplitude
539A   0061                     @@mid_vibr:     SLR     R1                                  ; medium vibrato --> 1/2 amplitude

                                                ; ------------------------------------------
                                                ; NOTE:
                                                ;   Vibrato is applied using the global
                                                ;   counter.  This synchronizes the effect
                                                ;   on all channels, and allows it to run
                                                ;   throughout the full length of the note.
                                                ; ------------------------------------------
                                                ;       |
                                                ;   +1 _|                  .#.
                                                ;       |                .`   `.
                                                ; +1/2 _|             .#         #.
                                                ;       |           .`             `.
                                                ;    0 _|____|___.#____|____|____|____#.___|____|
                                                ;       |      .`                       `.
                                                ; -1/2 _|   .#                             #.
                                                ;       | .`                                 `.
                                                ;   -1 _#
                                                ;       |
                                                ; ------------------------------------------
                                ;@@apply_vb:     MVI     _b_var(COUNT_M),  R2                ; apply vibrato
539B   0282 010F                @@apply_vb:     MVI     (array_TRK_BYTEVAR + COUNT_M),  R2                ; apply vibrato
539D   03BA 0007                                ANDI    #7,     R2                          ; according to current step
539F   02FA 53A2                                ADDI    #@@v_tb,R2                          ; (i.e. COUNT_M % 8)
53A1   0297                                     MVI@    R2,     PC

53A2   53AB 53AA                @@v_tb:         DECLE   @@vibr1, @@vibr2                    ; vibrato processing index
53A4   53B0 53AE                                DECLE   @@vibr0, @@vibr3
53A6   53AF 53AE                                DECLE   @@vibr4, @@vibr3
53A8   53B0 53AA                                DECLE   @@vibr0, @@vibr2

53AA   0061                     @@vibr2:        SLR     R1                                  ; - 1/2 amplitude
53AB   0108                     @@vibr1:        SUBR    R1,     R0                          ; - amplitude
53AC   0200 0002                                B       @@vibr0

53AE   0061                     @@vibr3:        SLR     R1                                  ; + 1/2 amplitude
53AF   00C8                     @@vibr4:        ADDR    R1,     R0                          ; + amplitude

                                                ; R0: Vibrato-adjusted period
                                                ; R1: Free
                                                ; R2: Free
                                                ; R3: Instrument
53B0   02AA                     @@vibr0:        MVI@    R5,     R2                          ; Get PSG period address argument

53B1   0250                                     MVO@    R0,     R2                          ; write period (low)
53B2   0040                                     SWAP    R0
53B3   02FA 0004                                ADDI    #4,     R2
53B5   0250                                     MVO@    R0,     R2                          ; write period (high)

                                                ; ------------------------------------------
                                                ; NOTE: The patch below allows for a channel
                                                ;       to be used for both DRUMS and TONE.
                                                ;
                                                ;       Drums are supported only on the "A"
                                                ;       channel, so if we made it down here
                                                ;       and we are an "A" channel, then it
                                                ;       means that we are not playing drums,
                                                ;       so we reset the "channel-enable"
                                                ;       flags to tone and no noise.
                                                ;
                                                ;       Also, we need to account for the
                                                ;       active-channel state.
                                                ; ------------------------------------------
53B6   0090                                     MOVR    R2,     R0
53B7   03B8 000F                                ANDI    #$F,    R0                          ; \_ Test for "A" channel
53B9   020C 0009                                BNZE    @@restore                           ; /     @@chn_a_hi = (@@chn_x_hi & $F)

53BB   0091                                     MOVR    R2,     R1
53BC   02F9 0004                                ADDI    #4,     R1                          ; Get @@chan_enable from @@chn_a_hi

53BE   0288                                     MVI@    R1,     R0                          ; \
53BF   03B8 00F6                                ANDI    #$F6,   R0                          ;  |_ Reset channel "A" to tone and no noise
53C1   02F8 0008                                ADDI    #$08,   R0                          ;  |    in case drums were used.
53C3   0248                                     MVO@    R0,     R1                          ; /     (@@chan_enable = %????1??0)

53C4   02B0                     @@restore:      PULR    R0                                  ; Restore decremented channel counter (i.e., COUNT_x - 1)

53C5   0378 0040                                CMPI    #64,    R0                          ; \_ Has the counter gone over?
53C7   0205 0006                                BLT     @@env                               ; /     No, process envelope ...

                                                ; Re-cycle the counter to backtrack the
                                                ; envelope
                                                ; ------------------------------------------
53C9   0081                                     MOVR    R0,     R1                          ; \
53CA   03B9 003F                                ANDI    #$3F,   R1                          ;  > offset = (counter & $3F) + rwd_cycle
53CC   02F9 0008                                ADDI    #TRK_ENV_REWIND_COUNT,  R1          ; /
53CE   0108                                     SUBR    R1,     R0                          ; counter -= offset

53CF   02A4                     @@env:          MVI@    R4,     R4                          ; R4 = pointer to envelope

                                                ; Compute the index to the envelope
                                                ; by adjusting the counter by the speed.
                                                ; ------------------------------------------
53D0   02E7                                     ADD@    R4,     PC                          ; Apply speed of envelope:
53D1   0060                                     SLR     R0                                  ;   0: 16 ticks \
53D2   0060                                     SLR     R0                                  ;   1:  8 ticks  |
53D3   0060                                     SLR     R0                                  ;   2:  4 ticks   > env_sp = (count / 2^(4 - speed))
53D4   0060                                     SLR     R0                                  ;   3:  2 ticks  |
                                                                                            ;   4:  1 tick  /
                                                ; R0: Envelope index
                                                ; R1: Free
                                                ; R2: Pointer to PSG.chn_x_hi
                                                ; R3: Pointer to INSTR_x
                                                ; R4: Pointer to envelope array
53D5   0081                                     MOVR    R0,     R1                          ; Keep a copy of the adjusted speed
53D6   0064                                     SLR     R0,     2                           ; \_ env += (env_sp / 4)
53D7   00C4                                     ADDR    R0,     R4                          ; /     (each data "record" contains 4 envelope elements)
53D8   02A0                                     MVI@    R4,     R0                          ; Get envelope data "record"
53D9   03B9 0003                                ANDI    #3,     R1                          ; \
53DB   02F9 53DE                                ADDI    #@@e_tb,R1                          ;  > Decode element nibble
53DD   028F                                     MVI@    R1,     PC                          ; /

53DE   53E5 53E2                @@e_tb:         DECLE   @@env0, @@env1
53E0   53E6 53E8                                DECLE   @@env2, @@env3

53E2   0040                     @@env1:         SWAP    R0                                  ; 2nd nybble: $0X00
53E3   0200 0003                                B       @@env3

53E5   0040                     @@env0:         SWAP    R0                                  ; 1st nybble: $X000

53E6   0064                     @@env2:         SLR     R0,     2                           ; 3rd nybble: $00X0
53E7   0064                                     SLR     R0,     2

53E8   03B8 000F                @@env3:         ANDI    #$F,    R0                          ; 4th nybble: $000X

                                ;               SUBI    #_b_vardlt(VOL_A, INSTR_A),R3       ; (R3 = VOL_x)
                                ;               SUBI    #((_b_var(INSTR_A) - _b_var(VOL_A)) AND $FFFF),R3       ; (R3 = VOL_x)
                                ;               SUBI    #(((array_TRK_BYTEVAR + INSTR_A) - _b_var(VOL_A)) AND $FFFF),R3       ; (R3 = VOL_x)
53EA   033B 0006                                SUBI    #(((array_TRK_BYTEVAR + INSTR_A) - (array_TRK_BYTEVAR + VOL_A)) AND $FFFF),R3       ; (R3 = VOL_x)
53EC   0318                                     SUB@    R3,           R0                    ; Adjust volume from song note
                                ;               SUB     _b_var(MASTER_FADER),      R0       ; Attenuate volume with global fader
53ED   0300 010D                                SUB     (array_TRK_BYTEVAR + MASTER_FADER),      R0       ; Attenuate volume with global fader

53EF   0203 0001                                BPL     @@upd_vol                           ; \_ Flatten volume at zero
53F1   01C0                                     CLRR    R0                                  ; /

                                                ; R0: Adjusted volume
                                                ; R1: Free
                                                ; R2: PSG.chn_x_hi
                                                ; R3: VOL_x
53F2   02FA 0007                @@upd_vol:      ADDI    #7,     R2                          ; @@chn_x_hi + 7 = @@chn_x_vol
53F4   0250                                     MVO@    R0,     R2                          ; apply new volume

53F5   02AF                                     MVI@    R5,     PC                          ; Jump to next procedure in chain

                                ;; ------------------------------------------------------------------------ ;;
                                ;;  Drums Synthesizer                                                       ;;
                                ;; ------------------------------------------------------------------------ ;;
                                ;;      R1: NOTE_x event data (current "note" >= 85)                        ;;
                                ;;      R2: COUNT_x value (pre-increment)                                   ;;
                                ;;      R3: Pointer to COUNT_x                                              ;;
                                ;;      R5: Input record followed by return address:                        ;;
                                ;;          Pointer to PSG channel low address (@@chn_x_lo)                 ;;
                                ;;                                                                          ;;
                                ;;  Drum Data Format (NOTE_x):                                              ;;
                                ;;      0ddd dddd                                                           ;;
                                ;;                                                                          ;;
                                ;;      Legend:                                                             ;;
                                ;;          d: Drum index number (85..127 : drum + 84)                      ;;
                                ;;                                                                          ;;
                                ;;  NOTE:   There's a global assumption that drums only play on channels    ;;
                                ;;          "A" and "D" (the first voice of each PSG device), and this      ;;
                                ;;          assumption drives some code optimizations.                      ;;
                                ;; ------------------------------------------------------------------------ ;;
                                                ; R0: Free
                                                ; R1: NOTE_x
                                                ; R2: COUNT_x
                                                ; R3: Pointer to COUNT_x
                                                ; R4: Free
                                                ; R5: input-rec[1]
53F6   037A 0010                @@drum:         CMPI    #TRK_DRUM_STEPS, R2                 ; Check if this is the end of drum?
53F8   020D 0028                                BGE     @@end_drums                         ;   Yes?  Jump to end.

53FA   0273                                     PSHR    R3                                  ; Save pointer to COUNT_x

53FB   0339 0055                                SUBI    #(@@nt_cnt + 1), R1                 ; Get drum index (drums start at 84 + (drum # > 1), 0 means unchanged)
                                ;               MVI     _w_var(SONG),    R3                 ; Get pointer to base of drums table ...
53FD   0283 0308                                MVI     (array_&TRK_WORDVAR + SONG),    R3                 ; Get pointer to base of drums table ...
53FF   02FB 0003                                ADDI    #3,     R3                          ;   which is 3 words after the song entry ptr.
5401   02D9                                     ADD@    R3,     R1
5402   028C                                     MVI@    R1,     R4

                                        IF (TRK_ENABLE_LONG_DRUMS)
                                                SLR     R2,     1                           ; If "long drums" are enabled, repeat each step twice
                                        ENDI

5403   004E                                     SLL     R2,     2                           ; Add current step
5404   00D4                                     ADDR    R2,     R4                          ;   drum = @@drum + (COUNT_x * 4)

5405   02AA                                     MVI@    R5,     R2                          ; Get @@chn_x_lo

5406   02A0                                     MVI@    R4,     R0                          ; tone period
5407   0250                                     MVO@    R0,     R2                          ; write period (low)
5408   0040                                     SWAP    R0
5409   02FA 0004                                ADDI    #4,     R2
540B   0250                                     MVO@    R0,     R2                          ; write period (high)

540C   0091                                     MOVR    R2,     R1                          ; \_ Get @@chan_enable from @@chn_a_hi
540D   02F9 0004                                ADDI    #4,     R1                          ; /     (drums are only on channel "a"!)

540F   02A0                                     MVI@    R4,     R0                          ; get noise period
5410   02A3                                     MVI@    R4,     R3                          ; enable tone / noise
5411   024B                                     MVO@    R3,     R1                          ; Set channel enable flags

5412   0009                                     INCR    R1                                  ; @@noise
5413   0248                                     MVO@    R0,     R1                          ; Set noise period

5414   02B3                                     PULR    R3                                  ; Restore pointer to COUNT_x
                                ;               SUBI    #_b_vardlt(VOL_A, COUNT_A),R3       ; (R3 = VOL_x)
                                ;               SUBI    #((_b_var(COUNT_A) - _b_var(VOL_A)) AND $FFFF),R3       ; (R3 = VOL_x)
                                ;               SUBI    #(((array_TRK_BYTEVAR + COUNT_A) - _b_var(VOL_A)) AND $FFFF),R3       ; (R3 = VOL_x)
5415   033B 000C                                SUBI    #(((array_TRK_BYTEVAR + COUNT_A) - (array_TRK_BYTEVAR + VOL_A)) AND $FFFF),R3       ; (R3 = VOL_x)

5417   02A0                                     MVI@    R4,           R0                    ; Get volume
5418   0318                                     SUB@    R3,           R0                    ; Adjust volume from song note
                                ;               SUB     _b_var(MASTER_FADER),      R0       ; Attenuate volume with global fader
5419   0300 010D                                SUB     (array_TRK_BYTEVAR + MASTER_FADER),      R0       ; Attenuate volume with global fader
541B   0203 0001                                BPL     @@drum_vol                          ; \_ but flatten at zero.
541D   01C0                                     CLRR    R0                                  ; /

541E   02FA 0007                @@drum_vol:     ADDI    #7,     R2                          ; Adjust pointer to channel volume
5420   0250                                     MVO@    R0,     R2                          ; Set channel volume

5421   02AF                                     MVI@    R5,     PC                          ; Jump to next procedure in chain

                                                ; ------------------------------------------
                                                ; When the last drum plays, we can't really
                                                ; tell in which state the noise and tone
                                                ; registers are, and we can't guarantee that
                                                ; another drum or tone is coming up to reset
                                                ; them.  Therefore, we need to silence the
                                                ; channel explicitly.
                                                ; ------------------------------------------
5422   02AA                     @@end_drums:    MVI@    R5,     R2                          ; \_ Get pointer to @@chn_a_vol
5423   02FA 000B                                ADDI    #$B,    R2                          ; /
5425   01C0                                     CLRR    R0                                  ; \_ Reset channel volume to zero
5426   0250                                     MVO@    R0,     R2                          ; /     (just in case ...)

5427   02AF                                     MVI@    R5,     PC                          ; Jump to next procedure in chain

                                ;; ======================================================================== ;;
                                ;;  Periods of the 84 defined notes                                         ;;
                                ;;  (from C-1 to B-7)                                                       ;;
                                ;; ======================================================================== ;;
5428   0D5C 0C9D 0BE7 0B3C      @@nt:           DECLE   $0D5C, $0C9D, $0BE7, $0B3C, $0A9B, $0A02, $0973, $08EB
542C   0A9B 0A02 0973 08EB 
5430   086B 07F2 0780 0714                      DECLE   $086B, $07F2, $0780, $0714, $06AE, $064E, $05F4, $059E
5434   06AE 064E 05F4 059E 
5438   054D 0501 04B9 0475                      DECLE   $054D, $0501, $04B9, $0475, $0435, $03F9, $03C0, $038A
543C   0435 03F9 03C0 038A 
5440   0357 0327 02FA 02CF                      DECLE   $0357, $0327, $02FA, $02CF, $02A7, $0281, $025D, $023B
5444   02A7 0281 025D 023B 
5448   021B 01FC 01E0 01C5                      DECLE   $021B, $01FC, $01E0, $01C5, $01AC, $0194, $017D, $0168
544C   01AC 0194 017D 0168 
5450   0153 0140 012E 011D                      DECLE   $0153, $0140, $012E, $011D, $010D, $00FE, $00F0, $00E2
5454   010D 00FE 00F0 00E2 
5458   00D6 00CA 00BE 00B4                      DECLE   $00D6, $00CA, $00BE, $00B4, $00AA, $00A0, $0097, $008F
545C   00AA 00A0 0097 008F 
5460   0087 007F 0078 0071                      DECLE   $0087, $007F, $0078, $0071, $006B, $0065, $005F, $005A
5464   006B 0065 005F 005A 
5468   0055 0050 004C 0047                      DECLE   $0055, $0050, $004C, $0047, $0043, $0040, $003C, $0039
546C   0043 0040 003C 0039 
5470   0035 0032 0030 002D                      DECLE   $0035, $0032, $0030, $002D, $002A, $0028, $0026, $0024
5474   002A 0028 0026 0024 
5478   0022 0020 001E 001C                      DECLE   $0022, $0020, $001E, $001C

0x54                            @@nt_cnt        EQU     ($ - @@nt)

                                ;; ======================================================================== ;;
                                ;;  Vibrato amplitude for each note above                                   ;;
                                ;;  (30% of an half-tone)                                                   ;;
                                ;; ======================================================================== ;;
547C   003B 0038 0035 0032                      DECLE   $003B, $0038, $0035, $0032, $002F, $002C, $002A, $0028
5480   002F 002C 002A 0028 
5484   0025 0023 0021 001F                      DECLE   $0025, $0023, $0021, $001F, $001E, $001C, $001A, $0019
5488   001E 001C 001A 0019 
548C   0018 0016 0015 0014                      DECLE   $0018, $0016, $0015, $0014, $0013, $0012, $0011, $0010
5490   0013 0012 0011 0010 
5494   000F 000E 000D 000C                      DECLE   $000F, $000E, $000D, $000C, $000C, $000B, $000A, $000A
5498   000C 000B 000A 000A 
549C   0009 0009 0008 0008                      DECLE   $0009, $0009, $0008, $0008, $0007, $0007, $0007, $0006
54A0   0007 0007 0007 0006 
54A4   0006 0006 0005 0005                      DECLE   $0006, $0006, $0005, $0005, $0005, $0004, $0004, $0004
54A8   0005 0004 0004 0004 
54AC   0004 0003 0003 0003                      DECLE   $0004, $0003, $0003, $0003, $0003, $0003, $0003, $0002
54B0   0003 0003 0003 0002 
54B4   0002 0002 0002 0002                      DECLE   $0002, $0002, $0002, $0002, $0002, $0002, $0002, $0002
54B8   0002 0002 0002 0002 
54BC   0001 0001 0001 0001                      DECLE   $0001, $0001, $0001, $0001, $0001, $0001, $0001, $0001
54C0   0001 0001 0001 0001 
54C4   0001 0001 0001 0001                      DECLE   $0001, $0001, $0001, $0001, $0001, $0001, $0001, $0001
54C8   0001 0001 0001 0001 
54CC   0001 0001 0001 0000                      DECLE   $0001, $0001, $0001, $0000
                                                ENDP

                                ;; ======================================================================== ;;
                                ;;  End of File:  tracker.asm                                               ;;
                                ;; ======================================================================== ;;
                                	;ENDFILE
                                	;FILE trk-demo.bas
                                	;[76] 
                                	SRCFILE "trk-demo.bas",76
                                	;[77] 	' INCLUDE SONGS:
                                	SRCFILE "trk-demo.bas",77
                                	;[78] 	'   Include any songs to play in your program.
                                	SRCFILE "trk-demo.bas",78
                                	;[79] 	'
                                	SRCFILE "trk-demo.bas",79
                                	;[80] 	'   Song are still defined using assembler data
                                	SRCFILE "trk-demo.bas",80
                                	;[81] 	'   structures and macros, and so must be loaded
                                	SRCFILE "trk-demo.bas",81
                                	;[82] 	'   as assembly language modules.
                                	SRCFILE "trk-demo.bas",82
                                	;[83] 
                                	SRCFILE "trk-demo.bas",83
                                	;[84] 	'   Include the standard global music definitions
                                	SRCFILE "trk-demo.bas",84
                                	;[85] 	ASM INCLUDE "music/global-music.asm"
                                	SRCFILE "trk-demo.bas",85
                                 INCLUDE "music/global-music.asm"
                                ;* ======================================================================== *;
                                ;*  This code is placed into the public domain by its collective authors.   *;
                                ;*  All copyright rights are hereby relinquished on the code and data in    *;
                                ;*  this file.                                                              *;
                                ;*      -- Arnauld Chevallier, 2018                                         *;
                                ;*      -- James Pujals, 2020                                               *;
                                ;*      -- Anders Carlsson, 2020                                            *;
                                ;* ======================================================================== *;

                                ;; ======================================================================== ;;
                                ;;  GLOBAL MUSIC DEFINITIONS                                                ;;
                                ;;      These elements are defined separately and made available to all     ;;
                                ;;      songs in the program.                                               ;;
                                ;;                                                                          ;;
                                ;;  Effects, arpeggios, & envelopes designed by:                            ;;
                                ;;      Arnauld Chevallier, James Pujals, & Anders Carlsson                 ;;
                                ;;                                                                          ;;
                                ;;  Drum sounds synthesized by:                                             ;;
                                ;;      James Pujals, based on work by Arnauld Chevallier                   ;;
                                ;; ======================================================================== ;;
0x54D0                          MUSIC           PROC

                                ;; ------------------------------------------------------------------------ ;;
                                ;;  Pitch effects                                                           ;;
                                ;; ------------------------------------------------------------------------ ;;
54D0   0000 0000 0000 0000      @@pitch01:      DECLE   0,  0,  0,  0               ; No effect
54D4   0000 0000 000C 000C      @@pitch02:      DECLE   0,  0, 12, 12               ; Alternate octaves every 2 ticks
54D8   0000 0005 0009 000C      @@pitch03:      DECLE   0,  5,  9, 12

54DC   0000 0003 0007 000C      @@pitch04:      DECLE   0,  3,  7, 12               ; fade + immediate
54E0   0000 0004 0007 000C      @@pitch05:      DECLE   0,  4,  7, 12               ; fade + immediate
54E4   0000 0004 000A 000C      @@pitch06:      DECLE   0,  4, 10, 12               ; fade
54E8   0000 0003 0006 0008      @@pitch07:      DECLE   0,  3,  6,  8               ; immediate
54EC   0000 0002 0005 000A      @@pitch08:      DECLE   0,  2,  5, 10               ; immediate
54F0   0000 0003 0005 0008      @@pitch09:      DECLE   0,  3,  5,  8               ; immediate
54F4   0000 0002 0006 0009      @@pitch10:      DECLE   0,  2,  6,  9               ; immediate
54F8   0000 0003 0005 0009      @@pitch11:      DECLE   0,  3,  5,  9               ; immediate
54FC   0000 0004 0007 0009      @@pitch12:      DECLE   0,  4,  7,  9               ; immediate
5500   0000 0003 0006 0009      @@pitch13:      DECLE   0,  3,  6,  9               ; immediate

5504   0000 0004 0006 000C      @@pitch14:      DECLE   0,  4,  6, 12
5508   0000 0003 0008 000C      @@pitch15:      DECLE   0,  3,  8, 12
550C   0000 0005 0008 000C      @@pitch16:      DECLE   0,  5,  8, 12
5510   0000 0002 0008 000C      @@pitch17:      DECLE   0,  2,  8, 12
5514   0000 0004 0009 000C      @@pitch18:      DECLE   0,  4,  9, 12

5518   0000 0000 0000 0001      @@pitch19:      DECLE   0,  0,  0,  1

                                ;; ------------------------------------------------------------------------ ;;
                                ;;  Envelopes                                                               ;;
                                ;; ------------------------------------------------------------------------ ;;
                                                ; Sharp attack, slow decay
551C   0001                     @@env01:        DECLE   1
551D   FFFF EEEE DDDD CCCC                      DECLE   $FFFF, $EEEE, $DDDD, $CCCC
5521   BBBB AAAA 9999 8888                      DECLE   $BBBB, $AAAA, $9999, $8888

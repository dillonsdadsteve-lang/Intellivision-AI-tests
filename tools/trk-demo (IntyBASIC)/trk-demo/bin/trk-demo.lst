                                	ENDP

                                	ENDI

                                	IF DEFINED intybasic_ecs
0x4800                          	ORG $4800	; Available up to $4FFF

                                	; Disable ECS ROMs so that they don't conflict with us
4800   02B8 2A5F                	MVII    #$2A5F, R0
4802   0240 2FFF                	MVO     R0,     $2FFF
4804   02B8 7A5F                	MVII    #$7A5F, R0
4806   0240 7FFF                	MVO     R0,     $7FFF
4808   02B8 EA5F                	MVII    #$EA5F, R0
480A   0240 EFFF                	MVO     R0,     $EFFF

480C   0220 37CC                	B       $1041       ; resume boot

                                	ENDI


                                ;@@808_cowb_hi:  DRUM($08C, $00, 1, 0, $F)   ; Classic TR-808 Cowbell:
59D7   008C 0000 0038 000F      @@808_cowb_hi:  DECLE   $08C, $00, (($39 - 1) - (0 SHL 3)), $F   ; Classic TR-808 Cowbell:
                                ;               DRUM($08C, $00, 1, 0, $D)   ;   It requires two tones simultaneously, and
59DB   008C 0000 0038 000D                      DECLE   $08C, $00, (($39 - 1) - (0 SHL 3)), $D   ;   It requires two tones simultaneously, and
                                ;               DRUM($08C, $00, 1, 0, $B)   ;   multiplexing them did not produce the desired
59DF   008C 0000 0038 000B                      DECLE   $08C, $00, (($39 - 1) - (0 SHL 3)), $B   ;   multiplexing them did not produce the desired
                                ;               DRUM($08C, $00, 1, 0, $A)   ;   effect.  Therefore, I broke it down into
59E3   008C 0000 0038 000A                      DECLE   $08C, $00, (($39 - 1) - (0 SHL 3)), $A   ;   effect.  Therefore, I broke it down into
                                ;               DRUM($08C, $00, 1, 0, $9)   ;   two "instruments," each one producing one
59E7   008C 0000 0038 0009                      DECLE   $08C, $00, (($39 - 1) - (0 SHL 3)), $9   ;   two "instruments," each one producing one
                                ;               DRUM($08C, $00, 1, 0, $8)   ;   tone.  They could be played simultaneously
59EB   008C 0000 0038 0008                      DECLE   $08C, $00, (($39 - 1) - (0 SHL 3)), $8   ;   tone.  They could be played simultaneously
                                ;               DRUM($08C, $00, 1, 0, $7)   ;   on the A and D drum channels.
59EF   008C 0000 0038 0007                      DECLE   $08C, $00, (($39 - 1) - (0 SHL 3)), $7   ;   on the A and D drum channels.
                                ;               DRUM($08C, $00, 1, 0, $6)   ;
59F3   008C 0000 0038 0006                      DECLE   $08C, $00, (($39 - 1) - (0 SHL 3)), $6   ;
                                ;               DRUM($08C, $00, 1, 0, $6)   ;   High tone:  ~800 Hz
59F7   008C 0000 0038 0006                      DECLE   $08C, $00, (($39 - 1) - (0 SHL 3)), $6   ;   High tone:  ~800 Hz
                                ;               DRUM($08C, $00, 1, 0, $5)   ;   |
59FB   008C 0000 0038 0005                      DECLE   $08C, $00, (($39 - 1) - (0 SHL 3)), $5   ;   |
                                ;               DRUM($08C, $00, 1, 0, $5)   ;   |
59FF   008C 0000 0038 0005                      DECLE   $08C, $00, (($39 - 1) - (0 SHL 3)), $5   ;   |
                                ;               DRUM($08C, $00, 1, 0, $5)   ;   |
5A03   008C 0000 0038 0005                      DECLE   $08C, $00, (($39 - 1) - (0 SHL 3)), $5   ;   |
                                ;               DRUM($08C, $00, 1, 0, $4)   ;   |
5A07   008C 0000 0038 0004                      DECLE   $08C, $00, (($39 - 1) - (0 SHL 3)), $4   ;   |
                                ;               DRUM($08C, $00, 1, 0, $4)   ;   |
5A0B   008C 0000 0038 0004                      DECLE   $08C, $00, (($39 - 1) - (0 SHL 3)), $4   ;   |
                                ;               DRUM($08C, $00, 1, 0, $4)   ;   |
5A0F   008C 0000 0038 0004                      DECLE   $08C, $00, (($39 - 1) - (0 SHL 3)), $4   ;   |
                                ;               DRUM($08C, $00, 1, 0, $3)   ;   v
5A13   008C 0000 0038 0003                      DECLE   $08C, $00, (($39 - 1) - (0 SHL 3)), $3   ;   v

